@page "/admin/phases/{ProjectId:int}"
@layout MainLayout
@attribute [Authorize(Roles = "Admin,Editor")]
@inject AdminService Admin
@inject HttpClient Http
@inject TranslationService T
@implements IDisposable

<PageTitle>@T["admin.phases"] — @T["auth.admin_portal"]</PageTitle>

<header class="admin-page-header admin-page-header-actions">
    <div>
        <a href="/admin/projects" class="admin-back-link">← @T["admin.back_to_projects"]</a>
        <p class="admin-eyebrow">@T["admin.projects"] / @(ProjectId.ToString("D2"))</p>
        <h1>@T["admin.phases"] <span class="admin-title-detail">@projectTitle</span></h1>
    </div>
    <button type="button" @onclick="Add" class="btn btn-primary">+ @T["admin.add_phase"]</button>
</header>

@if (!loaded)
{
    <div class="admin-loading" role="status"><span></span>@T["common.loading"]</div>
}
else
{
    <section class="phase-summary">
        <div><span>@T["admin.overall_progress"]</span><strong>@overallProgress%</strong></div>
        <div class="progress"><div class="progress-bar" style="width:@overallProgress%"></div></div>
    </section>

    <section class="phase-list">
        @foreach (var phase in phases)
        {
            <article class="phase-card">
                <div class="phase-rail"><span></span></div>
                <div class="phase-content">
                    <header>
                        <div>
                            <div class="phase-meta"><span class="status-badge @StatusClass(phase.Status)">@StatusText(phase.Status)</span><span>@phase.Progress%</span></div>
                            <h2>@phase.Title</h2>
                        </div>
                        <div class="admin-item-actions compact">
                            <button type="button" @onclick="() => Edit(phase)" class="btn btn-outline-light">@T["common.edit"]</button>
                            <button type="button" @onclick="() => Delete(phase.Id)" class="btn btn-outline-danger">@T["common.delete"]</button>
                        </div>
                    </header>
                    @if (!string.IsNullOrWhiteSpace(phase.Description)) { <p>@phase.Description</p> }
                    <div class="progress phase-progress"><div class="progress-bar" style="width:@phase.Progress%"></div></div>
                </div>
            </article>
        }
    </section>

    @if (phases.Count == 0 && editing is null)
    {
        <div class="admin-empty-state"><span>◫</span><p>@T["common.no_data"]</p><button type="button" class="btn btn-primary" @onclick="Add">@T["admin.add_phase"]</button></div>
    }

    @if (editing is not null)
    {
        <section class="admin-editor" aria-labelledby="phase-editor-title">
            <header class="editor-header"><div><span>@T["common.edit"]</span><h2 id="phase-editor-title">@(editing.Id == 0 ? T["admin.new_phase"] : T["admin.edit_phase"])</h2></div><button type="button" class="editor-close" @onclick="Cancel" aria-label="@T["common.close"]">×</button></header>
            <div class="row g-3">
                <div class="col-md-8"><label class="form-label">@T["admin.title"]</label><input @bind="editing.Title" class="form-control" /></div>
                <div class="col-md-4"><label class="form-label">@T["admin.status"]</label><select @bind="editing.Status" class="form-select"><option value="Pending">@T["admin.status_pending"]</option><option value="InProgress">@T["admin.status_in_progress"]</option><option value="Completed">@T["admin.status_completed"]</option><option value="OnHold">@T["admin.status_on_hold"]</option></select></div>
                <div class="col-12"><label class="form-label">@T["admin.description"]</label><textarea @bind="editing.Description" rows="3" class="form-control"></textarea></div>
                <div class="col-md-4"><label class="form-label">@T["admin.progress"] (%)</label><input @bind="editing.Progress" type="number" min="0" max="100" class="form-control" /></div>
                <div class="col-md-4"><label class="form-label">@T["admin.start_date"]</label><input @bind="editing.StartDate" type="date" class="form-control" /></div>
                <div class="col-md-4"><label class="form-label">@T["admin.end_date"]</label><input @bind="editing.EndDate" type="date" class="form-control" /></div>
            </div>
            <footer class="editor-actions"><button type="button" @onclick="Save" class="btn btn-primary">@T["common.save"]</button><button type="button" @onclick="Cancel" class="btn btn-outline-light">@T["common.cancel"]</button></footer>
        </section>
    }
}

@code {
    [Parameter] public int ProjectId { get; set; }
    private List<Portfolio.Data.Models.ProjectPhase> phases = new();
    private Portfolio.Data.Models.ProjectPhase? editing;
    private string projectTitle = "";
    private int overallProgress;
    private bool loaded;

    protected override void OnInitialized()
    {
        T.OnChange += Refresh;
        Load();
    }

    private async void Load()
    {
        try
        {
            phases = await Http.GetFromJsonAsync<List<Portfolio.Data.Models.ProjectPhase>>($"api/admin/phases/{ProjectId}") ?? new();
            var project = await Admin.GetProjectAsync(ProjectId);
            projectTitle = project?.Title ?? "";
            overallProgress = phases.Count > 0 ? (int)phases.Average(item => item.Progress) : 0;
        }
        catch
        {
            phases = new();
            overallProgress = 0;
        }
        loaded = true;
        await InvokeAsync(StateHasChanged);
    }

    private void Edit(Portfolio.Data.Models.ProjectPhase phase) => editing = new Portfolio.Data.Models.ProjectPhase
    {
        Id = phase.Id,
        ProjectId = ProjectId,
        Title = phase.Title,
        Description = phase.Description,
        Status = phase.Status,
        Progress = phase.Progress,
        StartDate = phase.StartDate,
        EndDate = phase.EndDate,
        SortOrder = phase.SortOrder
    };

    private void Add() => editing = new Portfolio.Data.Models.ProjectPhase { ProjectId = ProjectId, Progress = 0 };
    private void Cancel() => editing = null;

    private async Task Save()
    {
        if (editing is null)
            return;

        var response = editing.Id == 0
            ? await Http.PostAsJsonAsync("api/admin/phases", editing)
            : await Http.PutAsJsonAsync($"api/admin/phases/{editing.Id}", editing);
        if (response.IsSuccessStatusCode)
        {
            editing = null;
            Load();
        }
    }

    private async Task Delete(int id)
    {
        await Http.DeleteAsync($"api/admin/phases/{id}");
        Load();
    }

    private string StatusText(string status) => status switch
    {
        "InProgress" => T["admin.status_in_progress"],
        "Completed" => T["admin.status_completed"],
        "OnHold" => T["admin.status_on_hold"],
        _ => T["admin.status_pending"]
    };

    private static string StatusClass(string status) => status.ToLowerInvariant() switch
    {
        "inprogress" => "is-active",
        "completed" => "is-completed",
        "onhold" => "is-onhold",
        _ => "is-pending"
    };

    private void Refresh() => InvokeAsync(StateHasChanged);
    public void Dispose() => T.OnChange -= Refresh;
}
