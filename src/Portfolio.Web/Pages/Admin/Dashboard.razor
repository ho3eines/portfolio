@page "/admin"
@layout MainLayout
@attribute [Authorize(Roles = "Admin,Editor,Viewer")]
@inject AdminService Admin
@inject PortfolioService Portfolio
@inject HttpClient Http
@inject AuthenticationStateProvider AuthState
@inject TranslationService T

<PageTitle>@T["admin.dashboard"] — @T["auth.admin_portal"]</PageTitle>

<header class="admin-page-header">
    <div>
        <p class="admin-eyebrow">@T["admin.dashboard"] / 01</p>
        <h1 class="admin-title">@T["admin.dashboard_heading"]</h1>
        <p class="admin-sub">@T["admin.signed_in_as"] <span>@displayName</span></p>
    </div>
    <div class="admin-header-mark" aria-hidden="true"><span>01</span></div>
</header>

@if (!loaded)
{
    <div class="admin-loading" role="status"><span></span>@T["common.loading"]</div>
}
else
{
    @if (isStaff && unresolvedErrors > 0)
    {
        <div class="health-banner warn">
            <span><b>!</b> @string.Format(T["admin.unresolved_errors"], unresolvedErrors) — @T["admin.errors_warning"]</span>
            <a href="/admin/errors">@T["admin.view_errors"] <span aria-hidden="true">→</span></a>
        </div>
    }
    else if (isStaff)
    {
        <div class="health-banner ok"><span><b>✓</b> @T["admin.errors_ok"]</span></div>
    }

    <section class="admin-grid" aria-label="@T["admin.dashboard"]">
        <article class="stat-card"><span class="stat-index">01</span><div class="stat-num">@totalProjects</div><div class="stat-label">@T["admin.total_projects"]</div></article>
        <article class="stat-card"><span class="stat-index">02</span><div class="stat-num">@totalSkills</div><div class="stat-label">@T["admin.total_skills"]</div></article>
        <article class="stat-card"><span class="stat-index">03</span><div class="stat-num @(unreadMessages > 0 ? "danger" : null)">@(isStaff ? unreadMessages.ToString() : "—")</div><div class="stat-label">@T["admin.unread_messages"]</div></article>
        <article class="stat-card"><span class="stat-index">04</span><div class="stat-num">@totalTestimonials</div><div class="stat-label">@T["admin.total_testimonials"]</div></article>
    </section>

    @if (isStaff)
    {
        <section class="admin-card dashboard-actions">
            <div class="admin-card-heading">
                <span class="admin-card-icon">✦</span>
                <h2>@T["admin.quick_actions"]</h2>
            </div>
            <div class="quick-actions">
                <a href="/admin/profile"><span>01</span>@T["admin.edit_profile"] <b>→</b></a>
                <a href="/admin/projects"><span>02</span>@T["admin.projects"] <b>→</b></a>
                <a href="/admin/resources"><span>03</span>@T["admin.run_sql"] <b>→</b></a>
                <a href="/admin/messages"><span>04</span>@T["admin.messages"] <em>@unreadMessages</em><b>→</b></a>
                <a href="/admin/errors"><span>05</span>@T["admin.error_logs"] <b>→</b></a>
            </div>
        </section>
    }
    else
    {
        <section class="admin-card admin-empty-note">
            <span aria-hidden="true">◌</span>
            <p>@T["admin.read_only"]</p>
        </section>
    }
}

@code {
    private int totalProjects, totalSkills, unreadMessages, totalTestimonials, unresolvedErrors;
    private bool loaded;
    private bool isStaff;
    private string displayName = "";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var auth = await AuthState.GetAuthenticationStateAsync();
            isStaff = auth.User.IsInRole("Admin") || auth.User.IsInRole("Editor");
            var name = auth.User.Identity?.Name;
            var role = auth.User.FindFirst(claim => claim.Type == System.Security.Claims.ClaimTypes.Role)?.Value;
            displayName = string.IsNullOrEmpty(name) ? "User" : $"{name}{(string.IsNullOrEmpty(role) ? "" : $" · {role}")}";

            if (isStaff)
            {
                totalProjects = (await Admin.GetProjectsAsync()).Count;
                totalSkills = (await Admin.GetSkillsAsync()).Count;
                var messages = await Admin.GetMessagesAsync();
                unreadMessages = messages.Count(message => !message.IsRead);
                totalTestimonials = (await Admin.GetTestimonialsAsync()).Count;

                var errorResponse = await Http.GetFromJsonAsync<ErrorCountResponse>("api/admin/errors/count");
                unresolvedErrors = errorResponse?.unresolved ?? 0;
            }
            else
            {
                totalProjects = (await Portfolio.GetProjectsAsync()).Count;
                var (bars, tags) = await Portfolio.GetSkillsAsync();
                totalSkills = bars.Count + tags.Count;
                totalTestimonials = (await Portfolio.GetTestimonialsAsync()).Count;
            }
        }
        catch
        {
            // The screen still presents a stable zero-state when the API is offline.
        }
        loaded = true;
    }

    private sealed class ErrorCountResponse
    {
        public int unresolved { get; set; }
    }
}
