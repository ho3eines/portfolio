@page "/admin/contracts"
@layout MainLayout
@attribute [Authorize(Roles = "Admin,Editor")]
@inject AdminService Admin
@inject HttpClient Http
@inject TranslationService T
@implements IDisposable

<PageTitle>Contracts — Admin</PageTitle>
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 style="font-weight:700;margin:0;">Contracts</h1>
    <button @onclick="Add" class="btn btn-sm px-3" style="background:#d4a04c;color:#000;font-weight:600;">+ Add Contract</button>
</div>

@if (!loaded) { <p style="color:#9a9a9a;">Loading...</p> }
else
{
    <div class="row g-3">
        @foreach (var c in contracts)
        {
            var badge = c.Status switch { "Active" => "bg-success", "Completed" => "bg-primary", "Cancelled" => "bg-danger", _ => "bg-warning text-dark" };
            <div class="col-lg-6">
                <div class="card-dark p-3">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <strong class="text-light">@c.Title</strong>
                        <span class="badge @badge">@c.Status</span>
                    </div>
                    @if (!string.IsNullOrEmpty(c.ClientName)) { <small style="color:#d4a04c;">@c.ClientName</small> }
                    @if (c.Amount != null) { <small style="color:#9a9a9a;display:block;">@c.Amount?.ToString("N0") @c.Currency</small> }
                    @if (c.StartDate != null) { <small style="color:#9a9a9a;">@c.StartDate?.ToString("yyyy-MM-dd") — @(c.EndDate?.ToString("yyyy-MM-dd") ?? "Ongoing")</small> }
                    <div class="mt-2 d-flex gap-2">
                        <button @onclick="()=>Edit(c)" class="btn btn-sm btn-outline-light">Edit</button>
                        <button @onclick="()=>Delete(c.Id)" class="btn btn-sm btn-outline-danger">Del</button>
                    </div>
                </div>
            </div>
        }
    </div>

    @if (editing != null)
    {
        <div class="card-dark p-4 mt-3" style="max-width:700px;">
            <h5 class="text-light mb-3">@(editing.Id == 0 ? "New" : "Edit") Contract</h5>
            <div class="row g-2 mb-2">
                <div class="col-md-8"><input @bind="editing.Title" class="form-control bg-dark text-light border-secondary" placeholder="Title" /></div>
                <div class="col-md-4"><select @bind="editing.Status" class="form-select bg-dark text-light border-secondary"><option value="Pending">Pending</option><option value="Active">Active</option><option value="Completed">Completed</option><option value="Cancelled">Cancelled</option></select></div>
            </div>
            <div class="row g-2 mb-2">
                <div class="col-md-6"><input @bind="editing.ClientName" class="form-control bg-dark text-light border-secondary" placeholder="Client Name" /></div>
                <div class="col-md-6"><input @bind="editing.ClientEmail" class="form-control bg-dark text-light border-secondary" placeholder="Client Email" /></div>
            </div>
            <div class="row g-2 mb-2">
                <div class="col-md-4"><input @bind="editing.Amount" type="number" step="0.01" class="form-control bg-dark text-light border-secondary" placeholder="Amount" /></div>
                <div class="col-md-2"><select @bind="editing.Currency" class="form-select bg-dark text-light border-secondary"><option>EUR</option><option>USD</option><option>IRR</option></select></div>
                <div class="col-md-3"><input @bind="editing.StartDate" type="date" class="form-control bg-dark text-light border-secondary" /></div>
                <div class="col-md-3"><input @bind="editing.EndDate" type="date" class="form-control bg-dark text-light border-secondary" /></div>
            </div>
            <div class="mb-2"><textarea @bind="editing.Description" rows="2" class="form-control bg-dark text-light border-secondary" placeholder="Description"></textarea></div>
            <div class="d-flex gap-2"><button @onclick="Save" class="btn px-3" style="background:#d4a04c;color:#000;">Save</button><button @onclick="Cancel" class="btn btn-outline-light">Cancel</button></div>
        </div>
    }
}

<style>.card-dark{background:#141414;border:1px solid rgba(255,255,255,0.06);border-radius:12px;}</style>

@code {
    private List<Portfolio.Data.Models.Contract> contracts = new();
    private Portfolio.Data.Models.Contract? editing;
    private bool loaded;

    protected override void OnInitialized() { T.OnChange += Refresh; Load(); }
    private async void Load() { try { contracts = await Admin.GetContractsAsync(); } catch { } loaded = true; StateHasChanged(); }
    private void Edit(Portfolio.Data.Models.Contract c) => editing = new Portfolio.Data.Models.Contract { Id = c.Id, Title = c.Title, ClientName = c.ClientName, ClientEmail = c.ClientEmail, Amount = c.Amount, Currency = c.Currency, StartDate = c.StartDate, EndDate = c.EndDate, Status = c.Status, Description = c.Description };
    private void Add() => editing = new Portfolio.Data.Models.Contract();
    private void Cancel() => editing = null;
    private async Task Save() { if (editing == null) return; var h = editing.Id == 0 ? await Http.PostAsJsonAsync("api/admin/contracts", editing) : await Http.PutAsJsonAsync("api/admin/contracts/" + editing.Id, editing); if (h.IsSuccessStatusCode) { editing = null; Load(); } }
    private async Task Delete(int id) { await Http.DeleteAsync("api/admin/contracts/" + id); Load(); }
    private void Refresh() => InvokeAsync(StateHasChanged);
    public void Dispose() => T.OnChange -= Refresh;
}
