@page "/admin/messages"
@layout MainLayout
@attribute [Authorize(Roles = "Admin,Editor")]
@inject AdminService Admin
@inject TranslationService T

<PageTitle>@T["admin.messages"] — @T["auth.admin_portal"]</PageTitle>

<header class="admin-page-header">
    <div>
        <p class="admin-eyebrow">@T["admin.messages"] / 07</p>
        <h1>@T["admin.contact_messages"]</h1>
        <p>@string.Format(T["admin.unread_count"], unread)</p>
    </div>
</header>

@if (!loaded)
{
    <div class="admin-loading" role="status"><span></span>@T["common.loading"]</div>
}
else
{
    <div class="admin-filter-bar" role="group" aria-label="@T["admin.messages"]">
        <button type="button" @onclick="LoadAll" class="@(showUnread ? "btn btn-outline-light" : "btn btn-primary")">@T["common.all"]</button>
        <button type="button" @onclick="LoadUnread" class="@(!showUnread ? "btn btn-outline-light" : "btn btn-primary")">@T["admin.unread"] <span>@unread</span></button>
    </div>

    <section class="message-list">
        @foreach (var message in messages)
        {
            <article class="message-card @(message.IsRead ? "" : "is-unread")">
                <header>
                    <div class="message-sender"><span>@Initials(message.Name)</span><div><h2>@message.Name</h2><a href="mailto:@message.Email" dir="ltr">@message.Email</a></div></div>
                    <div class="message-meta"><time>@message.CreatedAt.ToString("yyyy-MM-dd HH:mm")</time><div class="admin-item-actions compact">@if (!message.IsRead) { <button type="button" @onclick="() => MarkRead(message.Id)" class="btn btn-outline-warning">@T["admin.mark_read"]</button> }<button type="button" @onclick="() => Delete(message.Id)" class="btn btn-outline-danger">@T["common.delete"]</button></div></div>
                </header>
                @if (!string.IsNullOrWhiteSpace(message.Subject)) { <h3>@message.Subject</h3> }
                <p>@message.Message</p>
            </article>
        }
    </section>

    @if (messages.Count == 0)
    {
        <div class="admin-empty-state"><span>✉</span><p>@T["admin.no_messages"]</p></div>
    }
}

@code {
    private List<Data.Models.ContactMessage> messages = new();
    private int unread;
    private bool loaded;
    private bool showUnread;

    protected override async Task OnInitializedAsync()
    {
        await LoadAll();
        loaded = true;
    }

    private async Task LoadAll()
    {
        messages = await Admin.GetMessagesAsync();
        unread = messages.Count(message => !message.IsRead);
        showUnread = false;
    }

    private async Task LoadUnread()
    {
        var allMessages = await Admin.GetMessagesAsync();
        unread = allMessages.Count(message => !message.IsRead);
        messages = allMessages.Where(message => !message.IsRead).ToList();
        showUnread = true;
    }

    private async Task MarkRead(int id)
    {
        await Admin.MarkReadAsync(id);
        if (showUnread)
            await LoadUnread();
        else
            await LoadAll();
    }

    private async Task Delete(int id)
    {
        await Admin.DeleteMessageAsync(id);
        if (showUnread)
            await LoadUnread();
        else
            await LoadAll();
    }

    private static string Initials(string name)
    {
        var initials = string.Join(string.Empty, name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(part => part[0]));
        return string.IsNullOrWhiteSpace(initials) ? "?" : initials.ToUpperInvariant();
    }
}
