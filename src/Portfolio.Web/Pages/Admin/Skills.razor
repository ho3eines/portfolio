@page "/admin/skills"
@layout MainLayout
@attribute [Authorize(Roles = "Admin,Editor")]
@inject AdminService Admin
@inject TranslationService T

<PageTitle>@T["admin.skills"] — @T["auth.admin_portal"]</PageTitle>

<header class="admin-page-header admin-page-header-actions">
    <div>
        <p class="admin-eyebrow">@T["admin.manage"] / 04</p>
        <h1>@T["admin.skills"]</h1>
        <p>@T["skills.title"]</p>
    </div>
    <button type="button" @onclick="Add" class="btn btn-primary">+ @T["admin.add_skill"]</button>
</header>

@if (!loaded)
{
    <div class="admin-loading" role="status"><span></span>@T["common.loading"]</div>
}
else
{
    <section class="skill-admin-grid">
        @foreach (var skill in skills)
        {
            <article class="skill-admin-card">
                <div class="skill-card-top"><span class="skill-icon">✦</span><span class="status-badge is-neutral">@(skill.IsTag ? T["admin.tag"] : T["admin.skill_bar"])</span></div>
                <h2>@skill.Name</h2>
                <p>@skill.Category</p>
                <div class="skill-card-meter"><div><span>@T["admin.proficiency"]</span><b>@skill.Proficiency%</b></div><i><em style="width:@skill.Proficiency%"></em></i></div>
                <footer class="admin-item-actions"><button type="button" @onclick="() => Edit(skill)" class="btn btn-outline-light">@T["common.edit"]</button><button type="button" @onclick="() => Delete(skill.Id)" class="btn btn-outline-danger">@T["common.delete"]</button></footer>
            </article>
        }
    </section>

    @if (skills.Count == 0 && editing is null)
    {
        <div class="admin-empty-state"><span>✦</span><p>@T["common.no_data"]</p><button type="button" class="btn btn-primary" @onclick="Add">@T["admin.add_skill"]</button></div>
    }

    @if (editing is not null)
    {
        <section class="admin-editor" aria-labelledby="skill-editor-title">
            <header class="editor-header"><div><span>@T["common.edit"]</span><h2 id="skill-editor-title">@(editing.Id == 0 ? T["admin.add_skill"] : T["common.edit"])</h2></div><button type="button" class="editor-close" @onclick="CancelEdit" aria-label="@T["common.close"]">×</button></header>
            <div class="row g-3">
                <div class="col-md-6"><label class="form-label">@T["admin.skill_name"]</label><input @bind="editing.Name" class="form-control" /></div>
                <div class="col-md-6"><label class="form-label">@T["admin.category"]</label><input @bind="editing.Category" class="form-control" /></div>
                <div class="col-md-6"><label class="form-label">@T["admin.proficiency"]</label><input @bind="editing.Proficiency" type="number" min="0" max="100" class="form-control" /></div>
                <div class="col-md-6"><label class="form-label">@T["admin.type"]</label><select @bind="editing.IsTag" class="form-select"><option value="false">@T["admin.skill_bar"]</option><option value="true">@T["admin.tag"]</option></select></div>
            </div>
            <footer class="editor-actions"><button type="button" @onclick="Save" class="btn btn-primary">@T["common.save"]</button><button type="button" @onclick="CancelEdit" class="btn btn-outline-light">@T["common.cancel"]</button></footer>
        </section>
    }
}

@code {
    private List<Data.Models.Skill> skills = new();
    private Data.Models.Skill? editing;
    private bool loaded;

    protected override async Task OnInitializedAsync()
    {
        try { skills = await Admin.GetSkillsAsync(); }
        catch { skills = new(); }
        loaded = true;
    }

    private void Edit(Data.Models.Skill skill) => editing = new()
    {
        Id = skill.Id,
        Name = skill.Name,
        Category = skill.Category,
        Proficiency = skill.Proficiency,
        IsTag = skill.IsTag
    };

    private void CancelEdit() => editing = null;
    private void Add() => editing = new Data.Models.Skill();

    private async Task Save()
    {
        if (editing is null)
            return;
        if (editing.Id == 0)
            await Admin.CreateSkillAsync(editing);
        else
            await Admin.UpdateSkillAsync(editing.Id, editing);
        editing = null;
        skills = await Admin.GetSkillsAsync();
    }

    private async Task Delete(int id)
    {
        await Admin.DeleteSkillAsync(id);
        skills = await Admin.GetSkillsAsync();
    }
}
