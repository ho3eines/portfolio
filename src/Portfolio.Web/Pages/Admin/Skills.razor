@page "/admin/skills"
@layout MainLayout
@attribute [Authorize(Roles = "Admin,Editor")]
@inject AdminService Admin

<PageTitle>Skills — Admin</PageTitle>
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 style="font-weight:700;margin:0;">Skills</h1>
    <button @onclick="Add" class="btn btn-sm px-3" style="background:#d4a04c;color:#000;font-weight:600;">+ Add Skill</button>
</div>

@if (!loaded) { <p style="color:#9a9a9a;">Loading…</p> }
else
{
    <table class="table table-dark table-borderless align-middle">
        <thead><tr style="border-bottom:1px solid rgba(255,255,255,0.06);"><th>Name</th><th>Category</th><th>Proficiency</th><th>Type</th><th style="width:160px;"></th></tr></thead>
        <tbody>
            @foreach (var s in skills)
            {
                @if (editing?.Id == s.Id)
                {
                    <tr>
                        <td><input @bind="editing.Name" class="form-control form-control-sm bg-dark text-light border-secondary" /></td>
                        <td><input @bind="editing.Category" class="form-control form-control-sm bg-dark text-light border-secondary" /></td>
                        <td><input @bind="editing.Proficiency" type="number" class="form-control form-control-sm bg-dark text-light border-secondary" style="width:80px;" /></td>
                        <td><select @bind="editing.IsTag" class="form-select form-select-sm bg-dark text-light border-secondary"><option value="false">Skill Bar</option><option value="true">Tag</option></select></td>
                        <td><button @onclick="Save" class="btn btn-sm" style="background:#d4a04c;color:#000;">✓</button><button @onclick="CancelEdit" class="btn btn-sm btn-outline-light ms-1">✗</button></td>
                    </tr>
                }
                else
                {
                    <tr>
                        <td class="text-light fw-medium">@s.Name</td><td style="color:#9a9a9a;">@s.Category</td>
                        <td><span style="color:#d4a04c;font-weight:600;">@s.Proficiency%</span></td>
                        <td><span class="badge" style="background:rgba(255,255,255,0.08);color:#9a9a9a;">@(s.IsTag ? "Tag" : "Bar")</span></td>
                        <td><button @onclick="()=>Edit(s)" class="btn btn-sm btn-outline-light">Edit</button><button @onclick="()=>Delete(s.Id)" class="btn btn-sm btn-outline-danger ms-1">Del</button></td>
                    </tr>
                }
            }
        </tbody>
    </table>
}

@code {
    private List<Data.Models.Skill> skills = new();
    private Data.Models.Skill? editing;
    private bool loaded;

    protected override async Task OnInitializedAsync() { skills = await Admin.GetSkillsAsync(); loaded = true; }
    private void Edit(Data.Models.Skill s) => editing = new() { Id=s.Id, Name=s.Name, Category=s.Category, Proficiency=s.Proficiency, IsTag=s.IsTag };
    private void CancelEdit() => editing = null;
    private void Add() => editing = new Data.Models.Skill();
    private async Task Save() { if (editing==null)return; if (editing.Id==0) await Admin.CreateSkillAsync(editing); else await Admin.UpdateSkillAsync(editing.Id, editing); editing=null;skills=await Admin.GetSkillsAsync(); }
    private async Task Delete(int id) { await Admin.DeleteSkillAsync(id); skills=await Admin.GetSkillsAsync(); }
}
