@page "/admin/resources"
@layout MainLayout
@attribute [Authorize(Roles = "Admin")]
@inject AdminService Admin

<PageTitle>Resource Runner — Admin</PageTitle>
<h1 style="font-weight:700;margin-bottom:8px;">SQL Resource Runner</h1>
<p style="color:#9a9a9a;font-size:.88rem;">Execute .sql files from <code style="color:#d4a04c;">wwwroot/resources</code>. Results logged to <b>Resources</b> table with <b>ErrorMessage</b> on failure.</p>

@if (!loaded) { <p style="color:#9a9a9a;">Loading…</p> }
else
{
    <div class="row">
        <div class="col-lg-5">
            <h6 class="text-light mb-3">Available SQL Files</h6>
            <div class="list-group mb-3">
                @foreach (var f in files)
                {
                    <button @onclick="()=>Execute(f)" disabled="@executing" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center bg-dark text-light border-secondary">
                        📄 @f
                        <span style="color:#d4a04c;font-size:.75rem;">Run →</span>
                    </button>
                }
            </div>
            @if (files.Length == 0) { <p style="color:#9a9a9a;">No .sql files found in wwwroot/resources.</p> }
            <button @onclick="ExecuteAll" disabled="@executing" class="btn btn-sm mb-3" style="background:#d4a04c;color:#000;font-weight:600;">▶ Run All Files</button>

            @if (!string.IsNullOrEmpty(resultMsg))
            {
                <div class="alert @(resultSuccess ? "alert-success" : "alert-danger") mt-2" style="background:@(resultSuccess?"rgba(76,175,80,0.15)":"rgba(244,67,54,0.15)");border-color:@(resultSuccess?"#4caf50":"#f44336");color:#fff;">
                    <pre style="margin:0;font-size:.8rem;white-space:pre-wrap;">@resultMsg</pre>
                </div>
            }
        </div>

        <div class="col-lg-7">
            <h6 class="text-light mb-3">Execution History (Resources Table)</h6>
            <div style="max-height:60vh;overflow-y:auto;">
                <table class="table table-dark table-sm table-borderless">
                    <thead><tr style="border-bottom:1px solid rgba(255,255,255,0.06);"><th>File</th><th>Status</th><th>Executed</th><th>Error</th></tr></thead>
                    <tbody>
                        @foreach (var h in history)
                        {
                            <tr>
                                <td style="font-size:.82rem;font-weight:500;">@h.FileName</td>
                                <td><span class="badge" style="background:@(h.IsSuccess?"rgba(76,175,80,0.2)":"rgba(244,67,54,0.2)");color:@(h.IsSuccess?"#4caf50":"#f44336")">@(h.IsSuccess ? "✓ OK" : "✗ ERROR")</span></td>
                                <td style="font-size:.78rem;color:#9a9a9a;">@h.ExecutedAt.ToString("MM-dd HH:mm:ss")</td>
                                <td style="font-size:.75rem;color:#f44336;max-width:300px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" title="@h.Error">@(h.Error ?? "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
                @if (history.Count == 0) { <p style="color:#9a9a9a;">No executions recorded yet.</p> }
            </div>
        </div>
    </div>
}

@code {
    private string[] files = Array.Empty<string>();
    private List<AdminService.ResourceHistory> history = new();
    private bool loaded, executing, resultSuccess;
    private string? resultMsg;

    protected override async Task OnInitializedAsync() { await Refresh(); loaded = true; }

    private async Task Refresh() { files = await Admin.ListResourceFilesAsync(); history = await Admin.GetResourceHistoryAsync(); }

    private async Task Execute(string fileName)
    {
        executing = true; resultMsg = $"Running {fileName}…";
        var (ok, msg) = await Admin.ExecuteResourceAsync(fileName);
        resultSuccess = ok; resultMsg = msg;
        executing = false; await Refresh();
    }

    private async Task ExecuteAll()
    {
        executing = true; resultMsg = "Running all files…";
        foreach (var f in files) { await Admin.ExecuteResourceAsync(f); }
        resultSuccess = true; resultMsg = $"All {files.Length} files processed.";
        executing = false; await Refresh();
    }
}
