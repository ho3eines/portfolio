@page "/admin/resources"
@layout MainLayout
@attribute [Authorize(Roles = "Admin")]
@inject AdminService Admin
@inject TranslationService T

<PageTitle>@T["admin.resources"] — @T["auth.admin_portal"]</PageTitle>

<header class="admin-page-header">
    <div>
        <p class="admin-eyebrow">@T["admin.system"] / 01</p>
        <h1>@T["admin.resource_runner"]</h1>
        <p>@T["admin.resource_intro"]</p>
    </div>
</header>

@if (!loaded)
{
    <div class="admin-loading" role="status"><span></span>@T["common.loading"]</div>
}
else
{
    <div class="resource-layout">
        <section class="admin-card resource-files">
            <div class="admin-card-heading"><span class="admin-card-icon">⌘</span><h2>@T["admin.available_sql_files"]</h2></div>
            <div class="resource-file-list">
                @foreach (var file in files)
                {
                    <button type="button" @onclick="() => Execute(file)" disabled="@executing" class="resource-file">
                        <span><b>SQL</b>@file</span><i>@T["admin.run"] <em>→</em></i>
                    </button>
                }
            </div>
            @if (files.Length == 0) { <p class="resource-empty">@T["admin.no_sql_files"]</p> }
            <button type="button" @onclick="ExecuteAll" disabled="@executing" class="btn btn-primary resource-run-all">@T["admin.run_all"] <span aria-hidden="true">→</span></button>

            @if (!string.IsNullOrEmpty(resultMsg))
            {
                <div class="resource-result @(resultSuccess ? "is-success" : "is-error")"><span>@(resultSuccess ? "✓" : "!")</span><pre>@resultMsg</pre></div>
            }
        </section>

        <section class="admin-card resource-history">
            <div class="admin-card-heading"><span class="admin-card-icon">◴</span><h2>@T["admin.execution_history"]</h2></div>
            <div class="table-responsive">
                <table class="table resource-table">
                    <thead><tr><th>@T["admin.file"]</th><th>@T["admin.status"]</th><th>@T["admin.executed"]</th><th>@T["admin.error"]</th></tr></thead>
                    <tbody>
                        @foreach (var item in history)
                        {
                            <tr>
                                <td><code>@item.FileName</code></td>
                                <td><span class="status-badge @(item.IsSuccess ? "is-completed" : "is-cancelled")">@(item.IsSuccess ? T["admin.status_ok"] : T["admin.status_error"])</span></td>
                                <td><time dir="ltr">@item.ExecutedAt.ToString("yyyy-MM-dd HH:mm:ss")</time></td>
                                <td class="resource-error" title="@item.ErrorMessage">@(item.ErrorMessage ?? "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (history.Count == 0) { <p class="resource-empty">@T["admin.no_executions"]</p> }
        </section>
    </div>
}

@code {
    private string[] files = Array.Empty<string>();
    private List<Portfolio.Data.Models.Resource> history = new();
    private bool loaded, executing, resultSuccess;
    private string? resultMsg;

    protected override async Task OnInitializedAsync()
    {
        await Refresh();
        loaded = true;
    }

    private async Task Refresh()
    {
        try
        {
            files = await Admin.ListResourceFilesAsync();
            history = await Admin.GetResourceHistoryAsync();
        }
        catch
        {
            files = Array.Empty<string>();
            history = new();
        }
    }

    private async Task Execute(string fileName)
    {
        executing = true;
        resultMsg = string.Format(T["admin.running_file"], fileName);
        var (ok, message) = await Admin.ExecuteResourceAsync(fileName);
        resultSuccess = ok;
        resultMsg = message;
        executing = false;
        await Refresh();
    }

    private async Task ExecuteAll()
    {
        executing = true;
        resultMsg = T["admin.running_all"];
        var allSucceeded = true;
        foreach (var file in files)
        {
            var (ok, _) = await Admin.ExecuteResourceAsync(file);
            allSucceeded &= ok;
        }
        resultSuccess = allSucceeded;
        resultMsg = string.Format(T["admin.all_processed"], files.Length);
        executing = false;
        await Refresh();
    }
}
