@page "/admin/profile"
@layout MainLayout
@attribute [Authorize(Roles = "Admin,Editor")]
@inject AdminService Admin

<PageTitle>Edit Profile — Admin</PageTitle>
<h1 style="font-weight:700;margin-bottom:8px;">Edit Profile</h1>
<p style="color:#9a9a9a;font-size:.85rem;margin-bottom:24px;">All changes are reflected immediately on the live site — including SEO meta tags.</p>

@if (model == null) { <p style="color:#9a9a9a;">Loading…</p> return; }

<div class="card-dark p-4 mb-4" style="max-width:800px;">
    @* == BASIC INFO == *@
    <h5 class="text-light mb-3">👤 Basic Information</h5>
    <div class="row g-3 mb-4">
        <div class="col-md-6">
            <label class="form-label text-light fw-semibold small">Full Name</label>
            <input @bind="model.FullName" class="form-control bg-dark text-light border-secondary" />
        </div>
        <div class="col-md-6">
            <label class="form-label text-light fw-semibold small">Title / Role</label>
            <input @bind="model.Title" class="form-control bg-dark text-light border-secondary" />
        </div>
    </div>

    @* == TAGLINE == *@
    <h5 class="text-light mb-3">📝 Hero Tagline</h5>
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <label class="form-label text-light fw-semibold small">Line 1</label>
            <input @bind="model.TaglineLine1" class="form-control bg-dark text-light border-secondary" placeholder="Crafting Digital" />
        </div>
        <div class="col-md-4">
            <label class="form-label text-light fw-semibold small">Line 2</label>
            <input @bind="model.TaglineLine2" class="form-control bg-dark text-light border-secondary" placeholder="Experiences" />
        </div>
        <div class="col-md-4">
            <label class="form-label text-light fw-semibold small">Line 3 (Gold)</label>
            <input @bind="model.TaglineLine3" class="form-control bg-dark text-light border-secondary" placeholder="That Inspire" />
        </div>
    </div>

    @* == BIO == *@
    <div class="mb-4">
        <label class="form-label text-light fw-semibold small">Bio</label>
        <textarea @bind="model.Bio" rows="4" class="form-control bg-dark text-light border-secondary"></textarea>
    </div>

    @* == LINKS == *@
    <h5 class="text-light mb-3">🔗 Links & Location</h5>
    <div class="row g-3 mb-4">
        <div class="col-md-6">
            <label class="form-label text-light fw-semibold small">Email</label>
            <input @bind="model.Email" class="form-control bg-dark text-light border-secondary" />
        </div>
        <div class="col-md-6">
            <label class="form-label text-light fw-semibold small">Location</label>
            <input @bind="model.Location" class="form-control bg-dark text-light border-secondary" />
        </div>
        <div class="col-md-4">
            <label class="form-label text-light fw-semibold small">LinkedIn URL</label>
            <input @bind="model.LinkedIn" class="form-control bg-dark text-light border-secondary" />
        </div>
        <div class="col-md-4">
            <label class="form-label text-light fw-semibold small">GitHub URL</label>
            <input @bind="model.GitHub" class="form-control bg-dark text-light border-secondary" />
        </div>
        <div class="col-md-4">
            <label class="form-label text-light fw-semibold small">Twitter URL</label>
            <input @bind="model.Twitter" class="form-control bg-dark text-light border-secondary" />
        </div>
        <div class="col-md-6">
            <label class="form-label text-light fw-semibold small">Showreel URL</label>
            <input @bind="model.ShowreelUrl" class="form-control bg-dark text-light border-secondary" placeholder="https://youtube.com/..." />
        </div>
        <div class="col-md-6">
            <label class="form-label text-light fw-semibold small">Profile Image URL</label>
            <input @bind="model.ProfileImageUrl" class="form-control bg-dark text-light border-secondary" />
        </div>
    </div>

    @* == SEO == *@
    <h5 class="text-light mb-3" style="color:#d4a04c !important;">🔍 SEO Settings</h5>
    <p class="text-muted small mb-3">These fields control how search engines and social media display your site.</p>
    <div class="row g-3 mb-3">
        <div class="col-12">
            <label class="form-label text-light fw-semibold small">
                Meta Description
                <span style="color:#9a9a9a;font-weight:400;">— used for Google snippets &amp; social previews (50-160 chars)</span>
            </label>
            <textarea @bind="model.MetaDescription" rows="2" class="form-control bg-dark text-light border-secondary" placeholder="Frontend Developer &amp; UI/UX Enthusiast based in Frankfurt. Crafting digital experiences with Blazor, .NET, and modern web technologies."></textarea>
            <small style="color:#9a9a9a;">@(model.MetaDescription?.Length ?? 0) / 160 characters</small>
        </div>
        <div class="col-12">
            <label class="form-label text-light fw-semibold small">
                Meta Keywords
                <span style="color:#9a9a9a;font-weight:400;">— comma-separated (less important for Google, still used by some engines)</span>
            </label>
            <input @bind="model.MetaKeywords" class="form-control bg-dark text-light border-secondary" placeholder="Mahbod Pour, frontend developer, Blazor, .NET, web developer Frankfurt" />
        </div>
        <div class="col-md-6">
            <label class="form-label text-light fw-semibold small">Open Graph Image URL</label>
            <input @bind="model.OgImageUrl" class="form-control bg-dark text-light border-secondary" placeholder="/images/og-default.jpg" />
        </div>
        <div class="col-md-6">
            <label class="form-label text-light fw-semibold small">Canonical Site URL</label>
            <input @bind="model.SiteUrl" class="form-control bg-dark text-light border-secondary" placeholder="https://mahbodpour.com" />
        </div>
        <div class="col-md-6">
            <label class="form-label text-light fw-semibold small">Google Analytics ID</label>
            <input @bind="model.GoogleAnalyticsId" class="form-control bg-dark text-light border-secondary" placeholder="G-XXXXXXXXXX" />
        </div>
    </div>

    <button @onclick="Save" class="btn px-4 mt-2" style="background:#d4a04c;color:#000;font-weight:600;">
        💾 Save All Changes
    </button>
    @if (saved) { <span class="ms-3" style="color:#4caf50;">✓ Profile updated — live site refreshed!</span> }
</div>

<style>.card-dark { background:#141414;border:1px solid rgba(255,255,255,0.06);border-radius:12px; }</style>

@code {
    private Data.Models.Profile? model;
    private bool saved;

    protected override async Task OnInitializedAsync() { model = await Admin.GetProfileAsync() ?? new(); }
    private async Task Save() { if (model != null) { await Admin.UpdateProfileAsync(model); saved = true; } }
}
