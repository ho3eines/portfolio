@page "/admin/profile"
@layout MainLayout
@attribute [Authorize(Roles = "Admin,Editor")]
@inject AdminService Admin
@inject TranslationService T

<PageTitle>@T["admin.profile"] — @T["auth.admin_portal"]</PageTitle>

<header class="admin-page-header">
    <div>
        <p class="admin-eyebrow">@T["admin.manage"] / 01</p>
        <h1>@T["admin.profile"]</h1>
        <p>@T["admin.profile_intro"]</p>
    </div>
</header>

@if (model is null)
{
    <div class="admin-loading" role="status"><span></span>@T["common.loading"]</div>
}
else
{
    <section class="profile-editor">
        <div class="admin-form-section">
            <header><span>01</span><div><h2>@T["admin.basic_information"]</h2><p>@T["admin.profile"]</p></div></header>
            <div class="row g-3">
                <div class="col-md-6"><label class="form-label">@T["admin.full_name"]</label><input @bind="model.FullName" class="form-control" /></div>
                <div class="col-md-6"><label class="form-label">@T["admin.role_title"]</label><input @bind="model.Title" class="form-control" /></div>
            </div>
        </div>

        <div class="admin-form-section">
            <header><span>02</span><div><h2>@T["admin.hero_tagline"]</h2><p>@T["hero.subtitle"]</p></div></header>
            <div class="row g-3">
                <div class="col-md-4"><label class="form-label">@T["admin.line_1"]</label><input @bind="model.TaglineLine1" class="form-control" /></div>
                <div class="col-md-4"><label class="form-label">@T["admin.line_2"]</label><input @bind="model.TaglineLine2" class="form-control" /></div>
                <div class="col-md-4"><label class="form-label">@T["admin.line_3_accent"]</label><input @bind="model.TaglineLine3" class="form-control" /></div>
                <div class="col-12"><label class="form-label">@T["admin.bio"]</label><textarea @bind="model.Bio" rows="4" class="form-control"></textarea></div>
            </div>
        </div>

        <div class="admin-form-section">
            <header><span>03</span><div><h2>@T["admin.links_location"]</h2><p>@T["contact.footer_connect"]</p></div></header>
            <div class="row g-3">
                <div class="col-md-6"><label class="form-label">@T["admin.email"]</label><input @bind="model.Email" dir="ltr" type="email" class="form-control" /></div>
                <div class="col-md-6"><label class="form-label">@T["admin.location"]</label><input @bind="model.Location" class="form-control" /></div>
                <div class="col-md-4"><label class="form-label">@T["admin.linkedin_url"]</label><input @bind="model.LinkedIn" dir="ltr" type="url" class="form-control" /></div>
                <div class="col-md-4"><label class="form-label">@T["admin.github_url"]</label><input @bind="model.GitHub" dir="ltr" type="url" class="form-control" /></div>
                <div class="col-md-4"><label class="form-label">@T["admin.twitter_url"]</label><input @bind="model.Twitter" dir="ltr" type="url" class="form-control" /></div>
                <div class="col-md-6"><label class="form-label">@T["admin.showreel_url"]</label><input @bind="model.ShowreelUrl" dir="ltr" type="url" class="form-control" /></div>
                <div class="col-md-6"><label class="form-label">@T["admin.profile_image_url"]</label><input @bind="model.ProfileImageUrl" dir="ltr" type="url" class="form-control" /></div>
            </div>
        </div>

        <div class="admin-form-section admin-form-section-seo">
            <header><span>04</span><div><h2>@T["admin.seo_settings"]</h2><p>@T["admin.seo_intro"]</p></div></header>
            <div class="row g-3">
                <div class="col-12"><label class="form-label">@T["admin.meta_description"] <span class="form-label-note">@T["admin.meta_description_hint"]</span></label><textarea @bind="model.MetaDescription" rows="3" class="form-control"></textarea><small class="field-counter">@(model.MetaDescription?.Length ?? 0) / 160</small></div>
                <div class="col-12"><label class="form-label">@T["admin.meta_keywords"] <span class="form-label-note">@T["admin.meta_keywords_hint"]</span></label><input @bind="model.MetaKeywords" dir="ltr" class="form-control" /></div>
                <div class="col-md-6"><label class="form-label">@T["admin.og_image_url"]</label><input @bind="model.OgImageUrl" dir="ltr" type="url" class="form-control" /></div>
                <div class="col-md-6"><label class="form-label">@T["admin.canonical_url"]</label><input @bind="model.SiteUrl" dir="ltr" type="url" class="form-control" /></div>
                <div class="col-md-6"><label class="form-label">@T["admin.analytics_id"]</label><input @bind="model.GoogleAnalyticsId" dir="ltr" class="form-control" /></div>
            </div>
        </div>

        <footer class="profile-savebar">
            <div>@if (saved) { <span class="save-confirmation">✓ @T["admin.profile_updated"]</span> }</div>
            <button type="button" @onclick="Save" class="btn btn-primary">@T["admin.save_profile"] <span aria-hidden="true">→</span></button>
        </footer>
    </section>
}

@code {
    private Data.Models.Profile? model;
    private bool saved;

    protected override async Task OnInitializedAsync()
    {
        model = await Admin.GetProfileAsync() ?? new();
    }

    private async Task Save()
    {
        if (model is null)
            return;
        saved = await Admin.UpdateProfileAsync(model);
    }
}
