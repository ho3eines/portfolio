@page "/admin/testimonials"
@layout MainLayout
@attribute [Authorize(Roles = "Admin,Editor")]
@inject AdminService Admin
@inject TranslationService T

<PageTitle>@T["admin.testimonials"] — @T["auth.admin_portal"]</PageTitle>

<header class="admin-page-header admin-page-header-actions">
    <div>
        <p class="admin-eyebrow">@T["admin.manage"] / 06</p>
        <h1>@T["admin.testimonials"]</h1>
        <p>@T["contact.testimonials_title"]</p>
    </div>
    <button type="button" @onclick="Add" class="btn btn-primary">+ @T["admin.add_testimonial"]</button>
</header>

@if (!loaded)
{
    <div class="admin-loading" role="status"><span></span>@T["common.loading"]</div>
}
else
{
    <section class="testimonial-admin-list">
        @foreach (var testimonial in testimonials)
        {
            <article class="testimonial-admin-card">
                <span class="testimonial-quote" aria-hidden="true">“</span>
                <div class="testimonial-card-header"><div><h2>@testimonial.ClientName</h2><p>@testimonial.ClientTitle</p></div><span class="testimonial-stars">@(new string('★', testimonial.Rating))</span></div>
                <blockquote>@testimonial.Content</blockquote>
                <footer class="admin-item-actions"><button type="button" @onclick="() => Edit(testimonial)" class="btn btn-outline-light">@T["common.edit"]</button><button type="button" @onclick="() => Delete(testimonial.Id)" class="btn btn-outline-danger">@T["common.delete"]</button></footer>
            </article>
        }
    </section>

    @if (testimonials.Count == 0 && editing is null)
    {
        <div class="admin-empty-state"><span>❝</span><p>@T["common.no_data"]</p><button type="button" class="btn btn-primary" @onclick="Add">@T["admin.add_testimonial"]</button></div>
    }

    @if (editing is not null)
    {
        <section class="admin-editor" aria-labelledby="testimonial-editor-title">
            <header class="editor-header"><div><span>@T["common.edit"]</span><h2 id="testimonial-editor-title">@(editing.Id == 0 ? T["admin.new_testimonial"] : T["admin.edit_testimonial"])</h2></div><button type="button" class="editor-close" @onclick="Cancel" aria-label="@T["common.close"]">×</button></header>
            <div class="row g-3">
                <div class="col-md-6"><label class="form-label">@T["admin.client_name"]</label><input @bind="editing.ClientName" class="form-control" /></div>
                <div class="col-md-6"><label class="form-label">@T["admin.client_title"]</label><input @bind="editing.ClientTitle" class="form-control" /></div>
                <div class="col-12"><label class="form-label">@T["admin.testimonial_text"]</label><textarea @bind="editing.Content" rows="4" class="form-control"></textarea></div>
                <div class="col-md-4"><label class="form-label">@T["admin.rating"]</label><input @bind="editing.Rating" type="number" min="1" max="5" class="form-control" /></div>
            </div>
            <footer class="editor-actions"><button type="button" @onclick="Save" class="btn btn-primary">@T["common.save"]</button><button type="button" @onclick="Cancel" class="btn btn-outline-light">@T["common.cancel"]</button></footer>
        </section>
    }
}

@code {
    private List<Data.Models.Testimonial> testimonials = new();
    private Data.Models.Testimonial? editing;
    private bool loaded;

    protected override async Task OnInitializedAsync()
    {
        try { testimonials = await Admin.GetTestimonialsAsync(); }
        catch { testimonials = new(); }
        loaded = true;
    }

    private void Edit(Data.Models.Testimonial testimonial) => editing = new()
    {
        Id = testimonial.Id,
        ClientName = testimonial.ClientName,
        ClientTitle = testimonial.ClientTitle,
        Content = testimonial.Content,
        Rating = testimonial.Rating
    };

    private void Add() => editing = new Data.Models.Testimonial { Rating = 5 };
    private void Cancel() => editing = null;

    private async Task Save()
    {
        if (editing is null)
            return;
        if (editing.Id == 0)
            await Admin.CreateTestimonialAsync(editing);
        else
            await Admin.UpdateTestimonialAsync(editing.Id, editing);
        editing = null;
        testimonials = await Admin.GetTestimonialsAsync();
    }

    private async Task Delete(int id)
    {
        await Admin.DeleteTestimonialAsync(id);
        testimonials = await Admin.GetTestimonialsAsync();
    }
}
