@page "/admin/errors"
@layout MainLayout
@attribute [Authorize(Roles = "Admin")]
@inject HttpClient Http
@inject TranslationService T

<PageTitle>@T["admin.error_logs"] — @T["auth.admin_portal"]</PageTitle>

<header class="admin-page-header">
    <div>
        <p class="admin-eyebrow">@T["admin.system"] / 02</p>
        <h1>@T["admin.errors_heading"]</h1>
        <p>@T["admin.errors_intro"]</p>
    </div>
</header>

@if (!loaded)
{
    <div class="admin-loading" role="status"><span></span>@T["common.loading"]</div>
}
else
{
    <div class="error-toolbar">
        <div class="admin-filter-bar" role="group" aria-label="@T["admin.error_logs"]">
            <button type="button" @onclick="() => Filter(null)" class="@(filter == "All" ? "btn btn-primary" : "btn btn-outline-light")">@T["common.all"] <span>@total</span></button>
            <button type="button" @onclick='() => Filter("Error")' class="@(filter == "Error" ? "btn btn-danger" : "btn btn-outline-light")">@T["admin.errors"]</button>
            <button type="button" @onclick='() => Filter("Warning")' class="@(filter == "Warning" ? "btn btn-warning" : "btn btn-outline-light")">@T["admin.warnings"]</button>
            <button type="button" @onclick='() => Filter("Unresolved")' class="@(filter == "Unresolved" ? "btn btn-primary" : "btn btn-outline-light")">@T["admin.unresolved"] <span>@unresolved</span></button>
        </div>
        <div class="admin-item-actions"><button type="button" @onclick="ResolveAll" class="btn btn-outline-success" disabled="@(unresolved == 0)">@T["admin.resolve_all"]</button><button type="button" @onclick="ClearAll" class="btn btn-outline-danger">@T["admin.clear_all"]</button></div>
    </div>

    @if (items.Count == 0)
    {
        <div class="admin-empty-state"><span>✓</span><p>@T["admin.no_errors"]</p></div>
    }
    else
    {
        <section class="error-list">
            @foreach (var item in items)
            {
                <article class="error-card @(item.IsResolved ? "is-resolved" : "is-open")">
                    <header>
                        <div class="error-card-title"><span class="status-badge @LevelClass(item.Level)">@LevelText(item.Level)</span><code>@item.Source</code>@if (item.StatusCode is not null) { <small>HTTP @item.StatusCode</small> }</div>
                        <time dir="ltr">@item.Timestamp.ToString("yyyy-MM-dd HH:mm:ss")</time>
                    </header>
                    <p>@item.Message</p>
                    @if (!string.IsNullOrWhiteSpace(item.RequestPath)) { <div class="error-request"><span>↗</span><code dir="ltr">@item.Method @item.RequestPath</code></div> }
                    @if (!string.IsNullOrWhiteSpace(item.StackTrace))
                    {
                        <details><summary>@T["admin.stack_trace"]</summary><pre dir="ltr">@item.StackTrace</pre></details>
                    }
                    <footer>
                        @if (!item.IsResolved) { <button type="button" @onclick="() => Resolve(item.Id)" class="btn btn-outline-success">@T["admin.resolve"]</button> }
                        else { <span class="resolved-note">✓ @T["admin.resolved_by"] @item.ResolvedBy</span> }
                        <button type="button" @onclick="() => Delete(item.Id)" class="btn btn-outline-danger">@T["common.delete"]</button>
                    </footer>
                </article>
            }
        </section>

        @if (total > pageSize)
        {
            <nav class="admin-pagination" aria-label="Pagination">
                <button type="button" @onclick="() => Page(-1)" disabled="@(page <= 1)" class="btn btn-outline-light">← @T["common.previous"]</button>
                <span>@string.Format(T["admin.page_of"], page, Math.Ceiling((double)total / pageSize))</span>
                <button type="button" @onclick="() => Page(1)" disabled="@(page * pageSize >= total)" class="btn btn-outline-light">@T["common.next"] →</button>
            </nav>
        }
    }
}

@code {
    private List<ErrorItem> items = new();
    private int total, unresolved, page = 1;
    private const int pageSize = 30;
    private string filter = "All";
    private bool loaded;

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        try
        {
            var query = $"api/admin/errors?page={page}&pageSize={pageSize}";
            if (filter is "Error" or "Warning") query += $"&level={filter}";
            if (filter == "Unresolved") query += "&unresolved=true";
            var response = await Http.GetFromJsonAsync<ErrorListResponse>(query);
            if (response is not null)
            {
                items = response.items;
                total = response.total;
                unresolved = response.unresolved;
            }
        }
        catch
        {
            items = new();
        }
        loaded = true;
    }

    private async Task Filter(string? selectedFilter)
    {
        filter = selectedFilter ?? "All";
        page = 1;
        await Load();
    }

    private async Task Page(int direction)
    {
        page = Math.Max(1, page + direction);
        await Load();
    }

    private async Task Resolve(int id)
    {
        await Http.PutAsync($"api/admin/errors/{id}/resolve", null);
        await Load();
    }

    private async Task ResolveAll()
    {
        await Http.PutAsync("api/admin/errors/resolve-all", null);
        await Load();
    }

    private async Task Delete(int id)
    {
        await Http.DeleteAsync($"api/admin/errors/{id}");
        await Load();
    }

    private async Task ClearAll()
    {
        await Http.DeleteAsync("api/admin/errors/clear");
        await Load();
    }

    private string LevelText(string level) => level switch
    {
        "Warning" => T["admin.warnings"],
        "Error" => T["admin.errors"],
        _ => level
    };

    private static string LevelClass(string level) => level switch
    {
        "Error" => "is-cancelled",
        "Warning" => "is-onhold",
        _ => "is-neutral"
    };

    public sealed class ErrorItem
    {
        public int Id { get; set; }
        public DateTime Timestamp { get; set; }
        public string Level { get; set; } = "";
        public string? Source { get; set; }
        public string Message { get; set; } = "";
        public string? StackTrace { get; set; }
        public string? RequestPath { get; set; }
        public string? Method { get; set; }
        public int? StatusCode { get; set; }
        public bool IsResolved { get; set; }
        public string? ResolvedBy { get; set; }
    }

    public sealed class ErrorListResponse
    {
        public List<ErrorItem> items { get; set; } = new();
        public int total { get; set; }
        public int unresolved { get; set; }
    }
}
