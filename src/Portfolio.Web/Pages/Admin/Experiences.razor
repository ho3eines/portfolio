@page "/admin/experiences"
@layout MainLayout
@attribute [Authorize(Roles = "Admin,Editor")]
@inject AdminService Admin

<PageTitle>Experiences — Admin</PageTitle>
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 style="font-weight:700;margin:0;">Experiences</h1>
    <button @onclick="Add" class="btn btn-sm px-3" style="background:#d4a04c;color:#000;font-weight:600;">+ Add</button>
</div>

@if (!loaded) { <p style="color:#9a9a9a;">Loading…</p> }
else
{
    <div class="row g-3">
        @foreach (var e in experiences)
        {
            <div class="col-lg-6">
                <div class="card-dark p-3">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <strong class="text-light">@e.Role</strong>
                            <div style="color:#d4a04c;font-size:.85rem;">@e.Company · @e.StartDate.Year — @(e.EndDate?.Year.ToString()??"Present")</div>
                            @if (!string.IsNullOrEmpty(e.Description)) { <small style="color:#9a9a9a;display:block;margin-top:6px;">@e.Description</small> }
                        </div>
                        <div class="d-flex gap-1">
                            <button @onclick="()=>Edit(e)" class="btn btn-sm btn-outline-light">Edit</button>
                            <button @onclick="()=>Delete(e.Id)" class="btn btn-sm btn-outline-danger">Del</button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    @if (editing != null)
    {
        <div class="card-dark p-4 mt-3" style="max-width:600px;">
            <h5 class="text-light mb-3">@(editing.Id==0?"New":"Edit") Experience</h5>
            <div class="row mb-2"><div class="col"><input @bind="editing.Company" class="form-control bg-dark text-light border-secondary" placeholder="Company" /></div><div class="col"><input @bind="editing.Role" class="form-control bg-dark text-light border-secondary" placeholder="Role" /></div></div>
            <div class="mb-2"><textarea @bind="editing.Description" rows="2" class="form-control bg-dark text-light border-secondary" placeholder="Description"></textarea></div>
            <div class="row mb-2"><div class="col"><label class="text-light small">Start</label><input @bind="editing.StartDate" type="date" class="form-control bg-dark text-light border-secondary" /></div><div class="col"><label class="text-light small">End (blank=Present)</label><input @bind="editing.EndDate" type="date" class="form-control bg-dark text-light border-secondary" /></div></div>
            <div class="d-flex gap-2"><button @onclick="Save" class="btn px-3" style="background:#d4a04c;color:#000;">Save</button><button @onclick="Cancel" class="btn btn-outline-light">Cancel</button></div>
        </div>
    }
}

<style>.card-dark { background:#141414;border:1px solid rgba(255,255,255,0.06);border-radius:12px; }</style>

@code {
    private List<Data.Models.Experience> experiences = new();
    private Data.Models.Experience? editing;
    private bool loaded;

    protected override async Task OnInitializedAsync() { experiences = await Admin.GetExperiencesAsync(); loaded = true; }
    private void Edit(Data.Models.Experience e) => editing = new() { Id=e.Id, Company=e.Company, Role=e.Role, Description=e.Description, StartDate=e.StartDate, EndDate=e.EndDate };
    private void Add() => editing = new Data.Models.Experience { StartDate=DateTime.Today };
    private void Cancel() => editing = null;
    private async Task Save() { if (editing==null)return; if (editing.Id==0) await Admin.CreateExperienceAsync(editing); else await Admin.UpdateExperienceAsync(editing.Id, editing); editing=null;experiences=await Admin.GetExperiencesAsync(); }
    private async Task Delete(int id) { await Admin.DeleteExperienceAsync(id); experiences=await Admin.GetExperiencesAsync(); }
}
