@page "/admin/experiences"
@layout MainLayout
@attribute [Authorize(Roles = "Admin,Editor")]
@inject AdminService Admin
@inject TranslationService T

<PageTitle>@T["admin.experiences"] — @T["auth.admin_portal"]</PageTitle>

<header class="admin-page-header admin-page-header-actions">
    <div>
        <p class="admin-eyebrow">@T["admin.manage"] / 05</p>
        <h1>@T["admin.experiences"]</h1>
        <p>@T["about.bio_2"]</p>
    </div>
    <button type="button" @onclick="Add" class="btn btn-primary">+ @T["admin.add_experience"]</button>
</header>

@if (!loaded)
{
    <div class="admin-loading" role="status"><span></span>@T["common.loading"]</div>
}
else
{
    <section class="experience-list">
        @foreach (var experience in experiences)
        {
            <article class="experience-card">
                <div class="experience-date"><span>@experience.StartDate.Year</span><i></i><span>@(experience.EndDate?.Year.ToString() ?? T["common.present"])</span></div>
                <div class="experience-copy"><span>@experience.Company</span><h2>@experience.Role</h2>@if (!string.IsNullOrWhiteSpace(experience.Description)) { <p>@experience.Description</p> }</div>
                <div class="admin-item-actions compact"><button type="button" @onclick="() => Edit(experience)" class="btn btn-outline-light">@T["common.edit"]</button><button type="button" @onclick="() => Delete(experience.Id)" class="btn btn-outline-danger">@T["common.delete"]</button></div>
            </article>
        }
    </section>

    @if (experiences.Count == 0 && editing is null)
    {
        <div class="admin-empty-state"><span>↗</span><p>@T["common.no_data"]</p><button type="button" class="btn btn-primary" @onclick="Add">@T["admin.add_experience"]</button></div>
    }

    @if (editing is not null)
    {
        <section class="admin-editor" aria-labelledby="experience-editor-title">
            <header class="editor-header"><div><span>@T["common.edit"]</span><h2 id="experience-editor-title">@(editing.Id == 0 ? T["admin.new_experience"] : T["admin.edit_experience"])</h2></div><button type="button" class="editor-close" @onclick="Cancel" aria-label="@T["common.close"]">×</button></header>
            <div class="row g-3">
                <div class="col-md-6"><label class="form-label">@T["admin.company"]</label><input @bind="editing.Company" class="form-control" /></div>
                <div class="col-md-6"><label class="form-label">@T["admin.role"]</label><input @bind="editing.Role" class="form-control" /></div>
                <div class="col-12"><label class="form-label">@T["admin.description"]</label><textarea @bind="editing.Description" rows="3" class="form-control"></textarea></div>
                <div class="col-md-6"><label class="form-label">@T["admin.start_date"]</label><input @bind="editing.StartDate" type="date" class="form-control" /></div>
                <div class="col-md-6"><label class="form-label">@T["admin.end_date"] <span class="form-label-note">@T["admin.end_date_present"]</span></label><input @bind="editing.EndDate" type="date" class="form-control" /></div>
            </div>
            <footer class="editor-actions"><button type="button" @onclick="Save" class="btn btn-primary">@T["common.save"]</button><button type="button" @onclick="Cancel" class="btn btn-outline-light">@T["common.cancel"]</button></footer>
        </section>
    }
}

@code {
    private List<Data.Models.Experience> experiences = new();
    private Data.Models.Experience? editing;
    private bool loaded;

    protected override async Task OnInitializedAsync()
    {
        try { experiences = await Admin.GetExperiencesAsync(); }
        catch { experiences = new(); }
        loaded = true;
    }

    private void Edit(Data.Models.Experience experience) => editing = new()
    {
        Id = experience.Id,
        Company = experience.Company,
        Role = experience.Role,
        Description = experience.Description,
        StartDate = experience.StartDate,
        EndDate = experience.EndDate
    };

    private void Add() => editing = new Data.Models.Experience { StartDate = DateTime.Today };
    private void Cancel() => editing = null;

    private async Task Save()
    {
        if (editing is null)
            return;
        if (editing.Id == 0)
            await Admin.CreateExperienceAsync(editing);
        else
            await Admin.UpdateExperienceAsync(editing.Id, editing);
        editing = null;
        experiences = await Admin.GetExperiencesAsync();
    }

    private async Task Delete(int id)
    {
        await Admin.DeleteExperienceAsync(id);
        experiences = await Admin.GetExperiencesAsync();
    }
}
