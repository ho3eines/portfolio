@page "/register"
@layout AuthLayout
@inject AuthService Auth
@inject NavigationManager Nav

<PageTitle>Register — Mahbod Pour</PageTitle>

<div class="auth-shell">
    <div class="auth-card">
        <div class="auth-brand">
            <div class="mark">Mahbod Pour</div>
            <div class="sub">Create Account</div>
        </div>

        @if (!string.IsNullOrEmpty(error)) { <div class="auth-error">@error</div> }
        @if (!string.IsNullOrEmpty(success)) { <div class="form-msg ok" style="text-align:center;margin-bottom:14px">@success</div> }

        <form @onsubmit:preventDefault="true" @onsubmit="HandleRegister">
            <div class="auth-field">
                <label for="fullName">Full Name</label>
                <input @bind="fullName" id="fullName" class="auth-input" placeholder="Your full name" />
            </div>
            <div class="auth-field">
                <label for="regUsername">Username</label>
                <input @bind="username" id="regUsername" class="auth-input" placeholder="Choose a username" required />
            </div>
            <div class="auth-field">
                <label for="regEmail">Email</label>
                <input @bind="email" id="regEmail" type="email" class="auth-input" placeholder="your@email.com" required />
            </div>
            <div class="auth-field">
                <label for="regPassword">Password</label>
                <input @bind="password" id="regPassword" type="password" class="auth-input" placeholder="Minimum 6 characters" required />
            </div>

            <button type="submit" disabled="@loading" class="auth-btn">
                @(loading ? "Creating account…" : "Register")
            </button>
        </form>

        <div class="auth-foot">
            Already have an account? <a href="/login">Sign In</a>
        </div>
    </div>
</div>

@code {
    private string fullName = "", username = "", email = "", password = "", error = "", success = "";
    private bool loading;

    private async Task HandleRegister()
    {
        error = ""; success = "";
        if (string.IsNullOrWhiteSpace(username) || string.IsNullOrWhiteSpace(email) || string.IsNullOrWhiteSpace(password))
        { error = "Please fill in all required fields."; return; }
        if (password.Length < 6)
        { error = "Password must be at least 6 characters."; return; }

        loading = true;
        try
        {
            if (await Auth.Register(username, email, password, fullName))
            {
                success = "Account created! Redirecting to login…";
                await Task.Delay(1500);
                Nav.NavigateTo("/login");
            }
            else error = "Registration failed. Username may already be taken.";
        }
        catch (HttpRequestException) { error = "Cannot reach the API server. Make sure Portfolio.Api is running."; }
        catch { error = "Connection error."; }
        finally { loading = false; }
    }
}
