@page "/register"
@layout AuthLayout
@inject AuthService Auth
@inject NavigationManager Nav
@inject TranslationService T

<PageTitle>@T["auth.register"] — @T["site.logo"]</PageTitle>

<div class="auth-shell">
    <div class="auth-orb auth-orb-one"></div>
    <div class="auth-orb auth-orb-two"></div>
    <section class="auth-card" aria-labelledby="register-heading">
        <div class="auth-card-top"><LangSwitcher /></div>
        <div class="auth-brand">
            <div class="auth-brand-mark">M</div>
            <div class="mark">@T["site.logo"]</div>
            <div class="sub">@T["auth.create_account"]</div>
        </div>

        @if (!string.IsNullOrEmpty(error)) { <div class="auth-error" role="alert">@error</div> }
        @if (!string.IsNullOrEmpty(success)) { <div class="auth-success" role="status">@success</div> }

        <form @onsubmit:preventDefault="true" @onsubmit="HandleRegister">
            <h1 id="register-heading" class="auth-heading">@T["auth.create_account"]</h1>
            <div class="auth-field">
                <label for="fullName">@T["auth.full_name"] <span>@T["common.optional"]</span></label>
                <input @bind="fullName" id="fullName" class="auth-input" placeholder="@T["auth.name_placeholder"]" autocomplete="name" />
            </div>
            <div class="auth-field">
                <label for="regUsername">@T["auth.username"]</label>
                <input @bind="username" id="regUsername" class="auth-input" dir="ltr" placeholder="@T["auth.username_placeholder"]" autocomplete="username" required />
            </div>
            <div class="auth-field">
                <label for="regEmail">@T["auth.email"]</label>
                <input @bind="email" id="regEmail" type="email" class="auth-input" dir="ltr" placeholder="you@example.com" autocomplete="email" required />
            </div>
            <div class="auth-field">
                <label for="regPassword">@T["auth.password"]</label>
                <input @bind="password" id="regPassword" type="password" dir="ltr" class="auth-input" placeholder="@T["auth.password_placeholder"]" autocomplete="new-password" required />
            </div>

            <button type="submit" disabled="@loading" class="auth-btn">
                @(loading ? T["auth.creating_account"] : T["auth.register"])
            </button>
        </form>

        <div class="auth-foot">
            @T["auth.have_account"] <a href="/login">@T["auth.sign_in"]</a>
        </div>
    </section>
</div>

@code {
    private string fullName = "", username = "", email = "", password = "", error = "", success = "";
    private bool loading;

    private async Task HandleRegister()
    {
        error = "";
        success = "";
        if (string.IsNullOrWhiteSpace(username) || string.IsNullOrWhiteSpace(email) || string.IsNullOrWhiteSpace(password))
        {
            error = T["auth.required_fields"];
            return;
        }
        if (password.Length < 6)
        {
            error = T["auth.password_minimum"];
            return;
        }

        loading = true;
        try
        {
            if (await Auth.Register(username, email, password, fullName))
            {
                success = T["auth.registration_success"];
                await Task.Delay(1500);
                Nav.NavigateTo("/login");
            }
            else
            {
                error = T["auth.registration_failed"];
            }
        }
        catch (HttpRequestException)
        {
            error = T["auth.api_unavailable"];
        }
        catch
        {
            error = T["auth.connection_error"];
        }
        finally
        {
            loading = false;
        }
    }
}
