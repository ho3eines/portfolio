@page "/register"
@layout AuthLayout
@inject AuthService Auth
@inject NavigationManager Nav

<PageTitle>Register — Admin</PageTitle>

<div class="login-wrap">
    <div class="login-card">
        <div class="login-head">
            <div class="login-logo">Mahbod Pour</div>
            <div class="login-sub">Create Admin Account</div>
        </div>

        @if (!string.IsNullOrEmpty(error))
        {
            <div class="login-error">@error</div>
        }
        @if (!string.IsNullOrEmpty(success))
        {
            <div class="login-success">@success</div>
        }

        <form @onsubmit:preventDefault="true" @onsubmit="HandleRegister">
            <div class="login-field">
                <label for="fullName">Full Name</label>
                <input @bind="fullName" id="fullName" class="login-input" placeholder="Your full name" />
            </div>
            <div class="login-field">
                <label for="regUsername">Username</label>
                <input @bind="username" id="regUsername" class="login-input" placeholder="Choose a username" required />
            </div>
            <div class="login-field">
                <label for="regEmail">Email</label>
                <input @bind="email" id="regEmail" type="email" class="login-input" placeholder="your@email.com" required />
            </div>
            <div class="login-field">
                <label for="regPassword">Password</label>
                <input @bind="password" id="regPassword" type="password" class="login-input" placeholder="Minimum 6 characters" required />
            </div>

            <button type="submit" disabled="@loading" class="login-btn">
                @(loading ? "Creating account…" : "Register")
            </button>
        </form>

        <div class="login-footer">
            Already have an account? <a href="/login">Sign In</a>
        </div>
    </div>
</div>

<style>
    body { margin: 0; background: #0b0d10; min-height: 100vh; }
    .login-wrap {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 1rem;
    }
    .login-card {
        background: #111316;
        border: 1px solid rgba(255, 255, 255, 0.06);
        border-radius: 18px;
        padding: 2.25rem;
        width: 100%;
        max-width: 420px;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.4);
    }
    .login-head { text-align: center; margin-bottom: 1.5rem; }
    .login-logo { font-family: 'Playfair Display', serif; font-size: 1.6rem; font-weight: 700; color: #c9a96a; }
    .login-sub { color: #8a8a8a; font-size: .85rem; margin-top: .35rem; }
    .login-field { margin-bottom: 1.1rem; }
    .login-field label { display: block; color: #d1d1d1; font-size: .85rem; margin-bottom: .45rem; }
    .login-input {
        width: 100%; padding: .75rem 1rem; border-radius: 10px;
        border: 1px solid rgba(255, 255, 255, 0.12);
        background: #0b0c10; color: #e0e0e0; outline: none;
        transition: border-color .2s;
        font-size: 0.95rem;
        box-sizing: border-box;
    }
    .login-input:focus { border-color: #c9a96a; box-shadow: 0 0 0 3px rgba(201,169,106,0.12); }
    .login-btn {
        width: 100%; padding: .85rem; border-radius: 10px;
        border: none; background: #c9a96a; color: #0b0d10;
        font-weight: 700; cursor: pointer; font-size: .95rem;
        transition: background .2s, transform .1s;
        margin-top: 0.5rem;
    }
    .login-btn:hover:not(:disabled) { background: #d4b473; transform: translateY(-1px); }
    .login-btn:disabled { opacity: .6; cursor: not-allowed; }
    .login-error {
        background: rgba(244, 67, 54, .12); color: #f44336;
        padding: .7rem 1rem; border-radius: 10px; text-align: center;
        font-size: .85rem; margin-bottom: 1rem;
        border: 1px solid rgba(244,67,54,0.2);
    }
    .login-success {
        background: rgba(76, 175, 80, .12); color: #4caf50;
        padding: .7rem 1rem; border-radius: 10px; text-align: center;
        font-size: .85rem; margin-bottom: 1rem;
        border: 1px solid rgba(76,175,80,0.2);
    }
    .login-footer { text-align: center; margin-top: 1.4rem; color: #8a8a8a; font-size: .82rem; }
    .login-footer a { color: #c9a96a; transition: color .2s; }
    .login-footer a:hover { color: #d4b473; }
</style>

@code {
    private string fullName = "", username = "", email = "", password = "", error = "", success = "";
    private bool loading;

    private async Task HandleRegister()
    {
        error = "";
        success = "";

        if (string.IsNullOrWhiteSpace(username) || string.IsNullOrWhiteSpace(email) || string.IsNullOrWhiteSpace(password))
        {
            error = "Please fill in all required fields.";
            return;
        }

        if (password.Length < 6)
        {
            error = "Password must be at least 6 characters.";
            return;
        }

        loading = true;
        StateHasChanged();

        try
        {
            if (await Auth.Register(username, email, password, fullName))
            {
                success = "Account created! Redirecting to login…";
                StateHasChanged();
                await Task.Delay(1500);
                Nav.NavigateTo("/login");
            }
            else
            {
                error = "Registration failed. Username may already be taken.";
            }
        }
        catch (HttpRequestException)
        {
            error = "Cannot reach the API server. Make sure Portfolio.Api is running.";
        }
        catch
        {
            error = "Connection error.";
        }
        finally
        {
            loading = false;
            StateHasChanged();
        }
    }
}
