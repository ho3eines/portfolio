@page "/login"
@inject AuthService Auth
@inject NavigationManager Nav
@inject TranslationService T

<PageTitle>Login — Mahbod Pour</PageTitle>
<div class="login-wrap">
    <div class="login-card">
        <div class="login-head">
            <div class="login-logo">@T["site.logo"]</div>
            <div class="login-sub">Admin Login</div>
        </div>

        @if (!string.IsNullOrEmpty(error))
        {
            <div class="login-error">@error</div>
        }

        <div class="login-field">
            <label>Username</label>
            <input @bind="username" class="login-input" placeholder="admin" />
        </div>
        <div class="login-field">
            <label>Password</label>
            <input @bind="password" type="password" class="login-input" placeholder="••••••••" />
        </div>

        <button @onclick="HandleLogin" disabled="@loading" class="login-btn">
            @(loading ? "Signing in…" : "Sign In")
        </button>

        <div class="login-footer">
            No account? <a href="/register">Register</a>
        </div>
    </div>
</div>

<style>
    body { background: #0b0d10; }
    .login-wrap {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 1rem;
    }
    .login-card {
        background: #111316;
        border: 1px solid rgba(255, 255, 255, 0.06);
        border-radius: 18px;
        padding: 2.25rem;
        width: 100%;
        max-width: 420px;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.4);
    }
    .login-head { text-align: center; margin-bottom: 1.5rem; }
    .login-logo { font-family: 'Playfair Display', serif; font-size: 1.6rem; font-weight: 700; color: #c9a96a; }
    .login-sub { color: #8a8a8a; font-size: .85rem; margin-top: .35rem; }
    .login-field { margin-bottom: 1.25rem; }
    .login-field label { display: block; color: #d1d1d1; font-size: .85rem; margin-bottom: .45rem; }
    .login-input {
        width: 100%; padding: .7rem 1rem; border-radius: 10px;
        border: 1px solid rgba(255, 255, 255, 0.12);
        background: #0b0c10; color: #e0e0e0; outline: none;
        transition: border-color .2s;
    }
    .login-input:focus { border-color: #c9a96a; }
    .login-btn {
        width: 100%; padding: .8rem; border-radius: 10px;
        border: none; background: #c9a96a; color: #0b0d10;
        font-weight: 600; cursor: pointer; font-size: .95rem;
        transition: background .2s;
    }
    .login-btn:hover:not(:disabled) { background: #d4b473; }
    .login-btn:disabled { opacity: .7; cursor: not-allowed; }
    .login-error {
        background: rgba(244, 67, 54, .12); color: #f44336;
        padding: .6rem 1rem; border-radius: 10px; text-align: center;
        font-size: .85rem; margin-bottom: 1rem;
    }
    .login-footer { text-align: center; margin-top: 1.2rem; color: #8a8a8a; font-size: .82rem; }
    .login-footer a { color: #c9a96a; }
</style>

@code {
    private string username = "admin", password = "Admin@123", error = "";
    private bool loading;

    private async Task HandleLogin()
    {
        error = "";
        loading = true;
        try
        {
            var r = await Auth.Login(username, password);
            if (r != null)
            {
                Nav.NavigateTo("/admin");
                return;
            }
            error = "Invalid credentials.";
        }
        catch
        {
            error = "Connection error — make sure the API is running.";
        }
        finally
        {
            loading = false;
        }
    }
}

