@page "/login"
@layout AuthLayout
@inject AuthService Auth
@inject NavigationManager Nav
@inject PortfolioService Portfolio
@inject TranslationService T

<PageTitle>@T["auth.sign_in"] — @(profile?.FullName ?? T["site.logo"])</PageTitle>

<div class="auth-shell">
    <div class="auth-orb auth-orb-one"></div>
    <div class="auth-orb auth-orb-two"></div>
    <section class="auth-card" aria-labelledby="login-heading">
        <div class="auth-card-top"><LangSwitcher /></div>
        <div class="auth-brand">
            <div class="auth-brand-mark">M</div>
            <div class="mark">@(profile?.FullName ?? T["site.logo"])</div>
            <div class="sub">@T["auth.admin_portal"]</div>
        </div>

        @if (!string.IsNullOrEmpty(error))
        {
            <div class="auth-error" role="alert">@error</div>
        }

        <form @onsubmit:preventDefault="true" @onsubmit="HandleLogin">
            <h1 id="login-heading" class="auth-heading">@T["auth.sign_in"]</h1>
            <div class="auth-field">
                <label for="username">@T["auth.username"]</label>
                <input @bind="username" id="username" class="auth-input" dir="ltr"
                       placeholder="admin" autocomplete="username" required />
            </div>
            <div class="auth-field">
                <label for="password">@T["auth.password"]</label>
                <input @bind="password" @bind:event="oninput" id="password" dir="ltr"
                       type="password" class="auth-input" placeholder="••••••••" autocomplete="current-password" required />
            </div>

            <button type="submit" disabled="@loading" class="auth-btn">
                @if (loading)
                {
                    <span class="auth-spinner"></span><span>@T["common.loading"]</span>
                }
                else
                {
                    <span>@T["auth.sign_in"]</span>
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                }
            </button>
        </form>

        <div class="auth-foot">
            <a href="/">← @T["auth.back_to_site"]</a>
        </div>
    </section>
</div>

@code {
    private string username = "", password = "", error = "";
    private bool loading;
    private Profile? profile;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            profile = await Portfolio.GetProfileAsync();
        }
        catch
        {
            // The identity mark has a bundled fallback when the public API is unavailable.
        }
    }

    private async Task HandleLogin()
    {
        if (string.IsNullOrWhiteSpace(username) || string.IsNullOrWhiteSpace(password))
        {
            error = T["auth.enter_credentials"];
            return;
        }

        error = "";
        loading = true;

        try
        {
            var result = await Auth.Login(username, password);
            if (result is not null)
            {
                Nav.NavigateTo("/admin", forceLoad: false);
                return;
            }
            error = T["auth.invalid_credentials"];
        }
        catch (HttpRequestException)
        {
            error = T["auth.api_unavailable"];
        }
        catch
        {
            error = T["auth.connection_error"];
        }
        finally
        {
            loading = false;
        }
    }
}
