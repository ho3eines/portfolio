@page "/login"
@layout AuthLayout
@inject AuthService Auth
@inject NavigationManager Nav
@inject PortfolioService Portfolio

<PageTitle>Login — @(profile?.FullName ?? "Mahbod Pour")</PageTitle>

<div class="auth-shell">
    <div class="auth-card">
        <div class="auth-brand">
            <div class="mark">@(profile?.FullName ?? "Mahbod Pour")</div>
            <div class="sub">Admin Panel</div>
        </div>

        @if (!string.IsNullOrEmpty(error))
        {
            <div class="auth-error">@error</div>
        }

        <form @onsubmit:preventDefault="true" @onsubmit="HandleLogin">
            <div class="auth-field">
                <label for="username">Username</label>
                <input @bind="username" id="username" class="auth-input"
                       placeholder="admin" autocomplete="username" required />
            </div>
            <div class="auth-field">
                <label for="password">Password</label>
                <input @bind="password" @bind:event="oninput" id="password"
                       type="password" class="auth-input"
                       placeholder="••••••••" autocomplete="current-password" required />
            </div>

            <button type="submit" disabled="@loading" class="auth-btn">
                @if (loading)
                {
                    <span class="auth-spinner"></span><span>Signing in…</span>
                }
                else
                {
                    <span>Sign In</span>
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                }
            </button>
        </form>

        <div class="auth-foot">
            <a href="/">← Back to site</a>
        </div>
    </div>
</div>

@code {
    private string username = "", password = "", error = "";
    private bool loading;
    private Profile? profile;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            profile = await Portfolio.GetProfileAsync();
        }
        catch
        {
            // Keep the bundled fallback name when the API is unavailable.
        }
    }

    private async Task HandleLogin()
    {
        if (string.IsNullOrWhiteSpace(username) || string.IsNullOrWhiteSpace(password))
        {
            error = "Please enter both username and password.";
            return;
        }

        error = "";
        loading = true;

        try
        {
            var r = await Auth.Login(username, password);
            if (r != null)
            {
                Nav.NavigateTo("/admin", forceLoad: false);
                return;
            }
            error = "Invalid credentials. Please check your username and password.";
        }
        catch (HttpRequestException)
        {
            error = "Cannot reach the API server. Make sure Portfolio.Api is running.";
        }
        catch (Exception ex)
        {
            error = $"Connection error: {ex.Message}";
        }
        finally
        {
            loading = false;
        }
    }
}
