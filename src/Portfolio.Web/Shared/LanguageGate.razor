@inject TranslationService T
@inject IJSRuntime JS
@implements IDisposable

@if (T.LanguageSelected)
{
    @ChildContent
}
else
{
    <main class="lang-gate" aria-labelledby="language-gate-title">
        <div class="lang-gate-orbit orbit-one"></div>
        <div class="lang-gate-orbit orbit-two"></div>
        <section class="lang-gate-card">
            <div class="lang-gate-mark" aria-hidden="true">
                <span class="mark-core">M</span>
                <span class="mark-ring"></span>
            </div>
            <p class="lang-gate-kicker">PORTFOLIO / 01</p>
            <h1 id="language-gate-title" class="lang-gate-title">Choose your language<span>زبان خود را انتخاب کنید</span></h1>
            <p class="lang-gate-sub">You can change this any time from the site or admin panel.<br />هر زمان می‌توانید زبان را تغییر دهید.</p>

            <div class="lang-gate-options">
                <button type="button" class="lang-option" disabled="@loading" @onclick='() => SelectLang("en")'>
                    <span class="lang-flag" aria-hidden="true">EN</span>
                    <span class="lang-info"><strong>English</strong><small>Continue in English</small></span>
                    <span class="lang-arrow" aria-hidden="true">→</span>
                </button>
                <button type="button" class="lang-option lang-option-fa" disabled="@loading" @onclick='() => SelectLang("fa")'>
                    <span class="lang-flag" aria-hidden="true">فا</span>
                    <span class="lang-info"><strong>فارسی</strong><small>ادامه به زبان فارسی</small></span>
                    <span class="lang-arrow" aria-hidden="true">←</span>
                </button>
            </div>

            @if (loading)
            {
                <div class="lang-gate-loading" role="status"><span class="lang-loader"></span><span>Loading language…</span></div>
            }
            else if (!string.IsNullOrWhiteSpace(gateError))
            {
                <p class="lang-gate-error" role="alert">@gateError</p>
            }
        </section>
    </main>
}

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private bool loading;
    private string? gateError;

    protected override void OnInitialized() => T.OnChange += Refresh;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            await JS.InvokeVoidAsync("portfolio.applyDocumentLanguage", T.Lang, T.Direction);
        }
        catch (JSException)
        {
            // Rendering remains usable even if JavaScript is restricted.
        }
    }

    private async Task SelectLang(string lang)
    {
        if (loading)
            return;

        loading = true;
        gateError = null;
        var selected = await T.SetLangAsync(lang);
        if (!selected)
            gateError = "Language files could not be loaded. Check your connection and try again.";
        loading = false;
        await InvokeAsync(StateHasChanged);
    }

    private void Refresh() => InvokeAsync(StateHasChanged);

    public void Dispose() => T.OnChange -= Refresh;
}
