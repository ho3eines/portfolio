@inject TranslationService T

@if (T.LanguageSelected)
{
    @ChildContent
}
else
{
    <div class="lang-gate">
        <div class="lang-gate-bg"></div>
        <div class="lang-gate-content">
            <div class="lang-gate-icon">
                <svg viewBox="0 0 100 100" fill="none"><circle cx="50" cy="50" r="44" stroke="var(--accent)" stroke-width="2" stroke-dasharray="10 5"/></svg>
                <span class="lang-gate-emoji">🌐</span>
            </div>
            <h1 class="lang-gate-title">Choose Your Language</h1>
            <p class="lang-gate-sub">Select your preferred language to continue</p>
            <div class="lang-gate-options">
                <button class="lang-option" @onclick="() => SelectLang(\"en\")">
                    <span class="lang-flag">🇬🇧</span>
                    <div class="lang-info"><strong>English</strong><small>United States · English</small></div>
                    <svg class="lang-arrow" width="20" height="20" viewBox="0 0 20 20" fill="none"><path d="M7 5l5 5-5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </button>
                <button class="lang-option" @onclick="() => SelectLang(\"fa\")">
                    <span class="lang-flag">🇮🇷</span>
                    <div class="lang-info"><strong>فارسی</strong><small>Iran · Persian</small></div>
                    <svg class="lang-arrow" width="20" height="20" viewBox="0 0 20 20" fill="none"><path d="M7 5l5 5-5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </button>
            </div>
            @if (loading)
            {
                <div class="lang-gate-loading"><div class="lang-loader"></div><span>Loading...</span></div>
            }
        </div>
    </div>
}

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    private bool loading;
    private async Task SelectLang(string lang) { loading = true; await T.SetLangAsync(lang); loading = false; }
}
