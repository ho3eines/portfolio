@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthState
@inject TranslationService T

@if (isAuthenticated)
{
    <div class="app-state access-denied">
        <div class="access-denied-mark" aria-hidden="true">!</div>
        <h1>@T["admin.access_denied"]</h1>
        <p>@T["admin.access_denied_text"]</p>
        <a href="/" class="btn-solid">@T["common.go_home"]</a>
    </div>
}
else
{
    <div class="app-state" role="status">@T["common.checking_authorization"]</div>
}

@code {
    private bool isAuthenticated;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthState.GetAuthenticationStateAsync();
        isAuthenticated = state.User.Identity?.IsAuthenticated == true;
        // Signed-in users without the required role stay here and receive a
        // clear explanation instead of being bounced through the login route.
        if (!isAuthenticated)
            Nav.NavigateTo("/login", forceLoad: true);
    }
}
