@inherits LayoutComponentBase
@inject NavigationManager Nav
@inject AuthService AuthService
@inject TranslationService T
@implements IDisposable

@if (IsAdminRoute)
{
    <div class="admin-shell @(T.IsRtl ? "is-rtl" : "is-ltr")" dir="@T.Direction" lang="@T.Lang" style="font-family:@T.FontFamily">
        <button type="button" class="admin-backdrop @(sidebarOpen ? "show" : "")" aria-label="@T["admin.close_navigation"]" @onclick="CloseSidebar"></button>

        <aside class="admin-side @(sidebarOpen ? "open" : "")" aria-label="@T["common.menu"]">
            <div class="admin-side-header">
                <a href="/" class="admin-brand" aria-label="@T["admin.back_to_site"]">
                    <span class="admin-brand-mark">M</span>
                    <span><strong>@T["site.logo"]</strong><small>@T["site.studio"]</small></span>
                </a>
                <button type="button" class="admin-sidebar-close" aria-label="@T["admin.close_navigation"]" @onclick="CloseSidebar">×</button>
            </div>

            <div class="admin-section-label">@T["admin.manage"]</div>
            <nav class="admin-nav-list">
                <AdminNavLink Href="/admin" Icon="⌂" Label="@T["admin.dashboard"]" OnNavigate="CloseSidebar" />
                <AdminNavLink Href="/admin/profile" Icon="◌" Label="@T["admin.profile"]" OnNavigate="CloseSidebar" />
                <AdminNavLink Href="/admin/projects" Icon="▣" Label="@T["admin.projects"]" OnNavigate="CloseSidebar" />
                <AdminNavLink Href="/admin/contracts" Icon="□" Label="@T["admin.contracts"]" OnNavigate="CloseSidebar" />
                <AdminNavLink Href="/admin/skills" Icon="✦" Label="@T["admin.skills"]" OnNavigate="CloseSidebar" />
                <AdminNavLink Href="/admin/experiences" Icon="↗" Label="@T["admin.experiences"]" OnNavigate="CloseSidebar" />
                <AdminNavLink Href="/admin/testimonials" Icon="❝" Label="@T["admin.testimonials"]" OnNavigate="CloseSidebar" />
                <AdminNavLink Href="/admin/messages" Icon="✉" Label="@T["admin.messages"]" OnNavigate="CloseSidebar" />
            </nav>

            <div class="admin-section-label admin-system-label">@T["admin.system"]</div>
            <nav class="admin-nav-list">
                <AdminNavLink Href="/admin/resources" Icon="⌘" Label="@T["admin.resources"]" OnNavigate="CloseSidebar" />
                <AdminNavLink Href="/admin/errors" Icon="!" Label="@T["admin.error_logs"]" OnNavigate="CloseSidebar" />
            </nav>

            <div class="spacer"></div>
            <div class="foot">
                <LangSwitcher />
                <button type="button" class="btn-accent-ghost" @onclick="OpenHelp">? <span>@T["admin.help"]</span></button>
                <a href="/" class="btn-ghost">← <span>@T["admin.back_to_site"]</span></a>
                <button type="button" class="btn-ghost" @onclick="Logout">@T["admin.logout"] <span aria-hidden="true">↗</span></button>
            </div>
        </aside>

        <main class="admin-main">
            <header class="admin-mobilebar">
                <button type="button" class="mobile-admin-toggle" aria-label="@T["admin.open_navigation"]" @onclick="ToggleSidebar">
                    <span class="menu-lines" aria-hidden="true"><i></i><i></i></span>
                    <span>@T["common.menu"]</span>
                </button>
                <a href="/" class="mobile-admin-brand">@T["site.logo"]</a>
                <LangSwitcher />
            </header>
            <div class="admin-content" @key="T.Lang">
                @Body
            </div>
        </main>

        <HelpPanel @ref="helpPanel" section="@currentHelpSection" Direction="@T.Direction" />
    </div>
}
else
{
    <div class="app-wrapper" dir="@T.Direction" lang="@T.Lang" style="font-family:@T.FontFamily" @key="T.Lang">
        @Body
    </div>
}

@code {
    private HelpPanel? helpPanel;
    private string? currentHelpSection;
    private bool sidebarOpen;

    private bool IsAdminRoute => Nav.Uri.Contains("/admin", StringComparison.OrdinalIgnoreCase);

    protected override void OnInitialized() => T.OnChange += Refresh;

    private void ToggleSidebar() => sidebarOpen = !sidebarOpen;
    private void CloseSidebar() => sidebarOpen = false;

    private async Task OpenHelp()
    {
        CloseSidebar();
        currentHelpSection = Nav.Uri switch
        {
            var u when u.Contains("/admin/profile") => "profile",
            var u when u.Contains("/admin/projects") && !u.Contains("phases") => "projects",
            var u when u.Contains("/admin/contracts") => "contracts",
            var u when u.Contains("/admin/phases") => "phases",
            var u when u.Contains("/admin/skills") => "skills",
            var u when u.Contains("/admin/experiences") => "experiences",
            var u when u.Contains("/admin/testimonials") => "testimonials",
            var u when u.Contains("/admin/messages") => "messages",
            var u when u.Contains("/admin/resources") => "resources",
            var u when u.Contains("/admin/errors") => "errors",
            var u when u.Contains("/admin") => "dashboard",
            _ => "getting_started"
        };

        await InvokeAsync(StateHasChanged);
        await Task.Yield();
        if (helpPanel is not null)
            await helpPanel.Open(currentHelpSection);
    }

    private void Refresh() => InvokeAsync(StateHasChanged);

    private async Task Logout()
    {
        await AuthService.Logout();
        Nav.NavigateTo("/");
    }

    public void Dispose() => T.OnChange -= Refresh;
}
