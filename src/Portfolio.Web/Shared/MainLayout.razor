@inherits LayoutComponentBase
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject AuthService AuthService
@inject TranslationService T
@implements IDisposable

@if (IsAdminRoute)
{
    <div class="admin-shell" style="direction:@T.Direction;font-family:@T.FontFamily">
        <div class="admin-backdrop @(sidebarOpen ? "show" : "")" @onclick="ToggleSidebar"></div>
        <nav class="admin-side @(sidebarOpen ? "open" : "")">
            <a href="/" class="admin-brand"><span class="dot"></span> @(T["site.logo"])</a>

            <div class="admin-section-label">Manage</div>
            <AdminNavLink Href="/admin" Icon="📊" Label="@T["admin.dashboard"]" />
            <AdminNavLink Href="/admin/profile" Icon="👤" Label="@T["admin.edit_profile"]" />
            <AdminNavLink Href="/admin/projects" Icon="📁" Label="@T["admin.total_projects"]" />
            <AdminNavLink Href="/admin/contracts" Icon="📋" Label="Contracts" />
            <AdminNavLink Href="/admin/skills" Icon="⚡" Label="@T["admin.total_skills"]" />
            <AdminNavLink Href="/admin/experiences" Icon="💼" Label="Experiences" />
            <AdminNavLink Href="/admin/testimonials" Icon="💬" Label="Testimonials" />
            <AdminNavLink Href="/admin/messages" Icon="✉️" Label="@T["admin.view_messages"]" />

            <div class="admin-section-label">System</div>
            <AdminNavLink Href="/admin/resources" Icon="🗄️" Label="@T["admin.run_sql"]" />
            <AdminNavLink Href="/admin/errors" Icon="🔍" Label="@T["admin.error_logs"]" />

            <div class="spacer"></div>
            <div class="foot">
                <LangSwitcher />
                <button class="btn-accent-ghost" @onclick="OpenHelp">📖 Help &amp; Guide</button>
                <a href="/" class="btn-ghost">← Back to Site</a>
                <button class="btn-ghost" @onclick="Logout">Logout</button>
            </div>
        </nav>

        <main class="admin-main">
            <div style="display:flex;align-items:center;gap:12px;margin-bottom:18px">
                <button class="mobile-admin-toggle" @onclick="ToggleSidebar">☰ Menu</button>
            </div>
            @Body
        </main>
    </div>
    <HelpPanel @ref="helpPanel" section="@currentHelpSection" />
}
else
{
    <div class="app-wrapper" style="direction:@T.Direction;font-family:@T.FontFamily">
        @Body
    </div>
}

@code {
    private HelpPanel? helpPanel;
    private string? currentHelpSection;
    private bool sidebarOpen;
    private bool IsAdminRoute => Nav.Uri.Contains("/admin", StringComparison.OrdinalIgnoreCase);

    protected override void OnInitialized()
    {
        // Subscribe before the first interaction so the root direction and
        // font change together with the page content.
        T.OnChange += Refresh;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Restore any persisted JWT so [Authorize] admin routes render.
            await AuthService.InitializeAsync();
        }
    }

    private void ToggleSidebar() => sidebarOpen = !sidebarOpen;

    private async void OpenHelp()
    {
        currentHelpSection = Nav.Uri switch
        {
            var u when u.Contains("/admin/profile") => "profile",
            var u when u.Contains("/admin/projects") && !u.Contains("phases") => "projects",
            var u when u.Contains("/admin/contracts") => "contracts",
            var u when u.Contains("/admin/phases") => "phases",
            var u when u.Contains("/admin/skills") => "skills",
            var u when u.Contains("/admin/experiences") => "experiences",
            var u when u.Contains("/admin/testimonials") => "testimonials",
            var u when u.Contains("/admin/messages") => "messages",
            var u when u.Contains("/admin/resources") => "resources",
            var u when u.Contains("/admin/errors") => "errors",
            var u when u.Contains("/admin") => "dashboard",
            _ => "getting_started"
        };
        StateHasChanged();
        await Task.Delay(50);
        if (helpPanel != null) await helpPanel.Open(currentHelpSection);
    }

    private void Refresh() => InvokeAsync(StateHasChanged);

    private async Task Logout()
    {
        await AuthService.Logout();
        Nav.NavigateTo("/");
    }

    public void Dispose() => T.OnChange -= Refresh;
}
