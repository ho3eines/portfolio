@inject TranslationService T
@implements IDisposable

<button type="button" class="lang-switch" @onclick="Toggle"
        title="@(T.Lang == "en" ? "Switch to Persian" : "Switch to English")"
        aria-label="Switch language">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.6" />
        <path d="M3 12h18M12 3c2.5 2.5 2.5 15 0 18M12 3c-2.5 2.5-2.5 15 0 18" stroke="currentColor" stroke-width="1.4" />
    </svg>
    @(T.Lang == "en" ? "فا" : "EN")
</button>

@code {
    protected override void OnInitialized() => T.OnChange += Refresh;
    public void Dispose() => T.OnChange -= Refresh;
    private void Refresh() => InvokeAsync(StateHasChanged);
    private async Task Toggle() => await T.ToggleAsync();
}
