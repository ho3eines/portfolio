@inject HttpClient Http
@inject NavigationManager Nav
@inject TranslationService T
@implements IDisposable

@if (visible)
{
    <button type="button" class="help-overlay" aria-label="@T["help.close"]" @onclick="Close"></button>
    <aside class="help-panel open" dir="@Direction" aria-modal="true" role="dialog" aria-labelledby="help-title">
        <header class="help-header">
            <div>
                <span class="help-eyebrow">@T["admin.help"]</span>
                <h3 id="help-title">@data?.GetValueOrDefault("title")?.ToString()</h3>
            </div>
            <button type="button" class="help-close" @onclick="Close" aria-label="@T["help.close"]">×</button>
        </header>
        <div class="help-body">
            @if (loading)
            {
                <div class="help-state"><span class="lang-loader"></span><span>@T["help.loading"]</span></div>
            }
            else if (data is null)
            {
                <p class="help-empty">@T["help.unavailable"]</p>
            }
            else
            {
                @if (data.ContainsKey("what"))
                {
                    <section class="help-section">
                        <h4>@T["help.what"]</h4>
                        <p>@data["what"]?.ToString()</p>
                    </section>
                }

                @if (data.ContainsKey("how"))
                {
                    <section class="help-section">
                        <h4>@T["help.how"]</h4>
                        @if (data["how"] is JsonElement howElement && howElement.ValueKind == JsonValueKind.Array)
                        {
                            <ol class="help-steps">
                                @foreach (var step in howElement.EnumerateArray())
                                {
                                    if (step.ValueKind == JsonValueKind.Object && step.TryGetProperty("step", out var stepTitle) && step.TryGetProperty("desc", out var stepDescription))
                                    {
                                        <li><strong>@stepTitle.GetString()</strong><span class="help-step-desc">@stepDescription.GetString()</span></li>
                                    }
                                    else
                                    {
                                        <li>@step.GetString()</li>
                                    }
                                }
                            </ol>
                        }
                    </section>
                }

                @if (data.ContainsKey("tips"))
                {
                    <section class="help-section">
                        <h4>@T["help.tips"]</h4>
                        @if (data["tips"] is JsonElement tipsElement && tipsElement.ValueKind == JsonValueKind.Array)
                        {
                            <ul class="help-tips">
                                @foreach (var tip in tipsElement.EnumerateArray())
                                {
                                    <li>@tip.GetString()</li>
                                }
                            </ul>
                        }
                    </section>
                }

                @if (section == "getting_started" && data.ContainsKey("steps"))
                {
                    <section class="help-section">
                        <h4>@T["help.quick_start"]</h4>
                        @if (data["steps"] is JsonElement stepsElement && stepsElement.ValueKind == JsonValueKind.Array)
                        {
                            <ol class="help-steps">
                                @foreach (var step in stepsElement.EnumerateArray())
                                {
                                    if (step.TryGetProperty("title", out var title) && step.TryGetProperty("desc", out var description))
                                    {
                                        <li><strong>@title.GetString()</strong><span class="help-step-desc">@description.GetString()</span></li>
                                    }
                                }
                            </ol>
                        }
                    </section>
                }
            }
        </div>
    </aside>
}

@code {
    [Parameter] public string? section { get; set; }
    [Parameter] public string Direction { get; set; } = "ltr";
    [Parameter] public EventCallback<bool> OnClose { get; set; }

    private bool visible;
    private bool loading;
    private Dictionary<string, object?>? data;

    public async Task Open(string? requestedSection = null)
    {
        if (requestedSection is not null)
            section = requestedSection;

        visible = true;
        await LoadCurrentSectionAsync();
    }

    public async Task Close()
    {
        visible = false;
        await OnClose.InvokeAsync(false);
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadCurrentSectionAsync()
    {
        loading = true;
        data = null;
        await InvokeAsync(StateHasChanged);

        var key = section ?? "getting_started";
        try
        {
            // Resolve the help dictionary against the app's own origin, not the
            // API base URL. The injected client may be rooted at a separate API
            // host; using an absolute URL here guarantees the static file is
            // fetched from the Blazor app (wwwroot/lang/help/*.json).
            var json = await Http.GetStringAsync($"{Nav.BaseUri}lang/help/{T.Lang}.json");
            using var document = JsonDocument.Parse(json);
            if (document.RootElement.TryGetProperty(key, out var sectionData))
                data = JsonSerializer.Deserialize<Dictionary<string, object?>>(sectionData.GetRawText());
        }
        catch
        {
            data = null;
        }
        finally
        {
            loading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void Refresh()
    {
        if (visible)
            _ = InvokeAsync(LoadCurrentSectionAsync);
        else
            _ = InvokeAsync(StateHasChanged);
    }

    protected override void OnInitialized() => T.OnChange += Refresh;
    public void Dispose() => T.OnChange -= Refresh;
}
