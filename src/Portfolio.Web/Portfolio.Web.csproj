<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Portfolio.Web</RootNamespace>
    <BlazorCacheBootResources>false</BlazorCacheBootResources>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="8.0.*" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="8.0.*" PrivateAssets="all" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Authentication" Version="8.0.*" />
    <PackageReference Include="System.Net.Http.Json" Version="8.0.*" />
    <PackageReference Include="Blazored.LocalStorage" Version="4.5.*" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="7.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Portfolio.Data\Portfolio.Data.csproj" />
  </ItemGroup>

  <!-- 
    Exclude the static-preview stub for blazor.webassembly.js from Static Web Assets discovery.
    The file must remain in wwwroot so that:
      - npx serve / preview-server can serve it (prevents 404 on /_framework/blazor.webassembly.js)
      - Static hosting / GitHub Pages / Arena previews work without dotnet build
    But the Blazor SDK + GenerateStaticWebAssets* tasks assume they are the sole provider of _framework files.
    Including the checked-in stub causes:
      Sequence contains more than one element (SingleOrDefault in ComputeManifestAssets / ComputeDevelopmentManifest)
  -->
  <ItemGroup>
    <Content Remove="wwwroot/_framework/blazor.webassembly.js" />
    <!-- Also ensure it is never copied during publish (the real framework comes from the SDK) -->
    <None Include="wwwroot/_framework/blazor.webassembly.js" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
  </ItemGroup>

</Project>
