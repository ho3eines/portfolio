@using Microsoft.AspNetCore.Components.Authorization
@inject TranslationService T

<CascadingAuthenticationState>
    <LanguageGate>
        <Router AppAssembly="@typeof(App).Assembly">
            <Found Context="routeData">
                <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
                    <NotAuthorized>
                        <RedirectToLogin />
                    </NotAuthorized>
                    <Authorizing>
                        <div class="app-state" role="status">
                            <div class="app-state-spinner"></div>
                            <span>@T["common.checking_authorization"]</span>
                        </div>
                    </Authorizing>
                </AuthorizeRouteView>
                <FocusOnNavigate RouteData="@routeData" Selector="h1" />
            </Found>
            <NotFound>
                <PageTitle>404 — @T["common.page_not_found"]</PageTitle>
                <LayoutView Layout="@typeof(MainLayout)">
                    <div class="app-state app-not-found">
                        <span class="app-state-code">404</span>
                        <h1>@T["common.page_not_found"]</h1>
                        <a href="/" class="btn-solid">@T["common.go_home"]</a>
                    </div>
                </LayoutView>
            </NotFound>
        </Router>
    </LanguageGate>
</CascadingAuthenticationState>
